Функция СериализоватьДанные(ДанныеНастройки, Данные)

	Корень = Новый Структура;
	Корень.Вставить("apiVersion", ДанныеНастройки.ВерсияAPI);
	Корень.Вставить("data", Данные);

	Если ДанныеНастройки.ФорматОтвета <> Перечисления.МС_ФорматОтветаAPI.JSON Тогда
		Возврат УпрощенныйXMLИзСтруктуры(Корень);
	КонецЕсли;

	Настройки = НастройкиЗаписиJSON(ДанныеНастройки.JSONПараметрыЗаписи);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSONИзНастроек(Настройки));
	ЗаписатьЗначениеДляJSON(ЗаписьJSON, Корень, Настройки.ФорматДаты);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Процедура ЗаписатьЗначениеДляJSON(ЗаписьJSON, Значение, ФорматДаты)

	// Экранирование строк выполняет ЗаписьJSON по параметрам записи настройки.

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого КлючИЗначение Из Значение Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(Строка(КлючИЗначение.Ключ));
			ЗаписатьЗначениеДляJSON(ЗаписьJSON, КлючИЗначение.Значение, ФорматДаты);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьЗначениеДляJSON(ЗаписьJSON, Элемент, ФорматДаты);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
	ИначеЕсли ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		ЗаписьJSON.ЗаписатьЗначение(ДатаДляJSON(Значение, ФорматДаты));
	ИначеЕсли Значение = Неопределено Или Значение = NULL Тогда
		ЗаписьJSON.ЗаписатьЗначение(Неопределено);
	Иначе
		ЗаписьJSON.ЗаписатьЗначение(Строка(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ДатаДляJSON(Значение, ФорматДаты)

	// UnixTime - число секунд от 01.01.1970 UTC; иначе ISO 8601 - "2024-01-31T10:00:00" (время сервера).
	// Пустая дата выводится как null.

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	ИначеЕсли ФорматДаты = ФорматДатыUnixTime() Тогда
		Возврат УниверсальноеВремя(Значение) - Дата(1970, 1, 1);
	Иначе
		Возврат XMLСтрока(Значение);
	КонецЕсли;

КонецФункции

Функция ФорматДатыISO8601()

	Возврат "ISO8601";

КонецФункции

Функция ФорматДатыUnixTime()

	Возврат "UnixTime";

КонецФункции

Функция ПараметрыЗаписиJSONИзНастроек(Настройки)

	ВариантыПереноса = Новый Соответствие;
	ВариантыПереноса.Вставить("НЕТ", ПереносСтрокJSON.Нет);
	ВариантыПереноса.Вставить("UNIX", ПереносСтрокJSON.Unix);
	ВариантыПереноса.Вставить("WINDOWS", ПереносСтрокJSON.Windows);
	Перенос = ВариантыПереноса.Получить(ВРег(Настройки.ПереносСтрок));

	ВариантыЭкранирования = Новый Соответствие;
	ВариантыЭкранирования.Вставить("СИМВОЛЫВНЕASCII", ЭкранированиеСимволовJSON.СимволыВнеASCII);
	ВариантыЭкранирования.Вставить("СИМВОЛЫВНЕBMP", ЭкранированиеСимволовJSON.СимволыВнеBMP);
	Экранирование = ВариантыЭкранирования.Получить(ВРег(Настройки.ЭкранированиеСимволов));

	// Реквизит "ЭкранироватьКавычки" исторически хранит параметр ЭкранироватьСлеш.
	Возврат Новый ПараметрыЗаписиJSON(
		?(Перенос = Неопределено, ПереносСтрокJSON.Авто, Перенос),
		Настройки.СимволыОтступа,
		Настройки.ИспользоватьДвойныеКавычки,
		?(Экранирование = Неопределено, ЭкранированиеСимволовJSON.Нет, Экранирование),
		Настройки.ЭкранироватьУгловыеСкобки,
		Настройки.ЭкранироватьРазделительСтрок,
		Настройки.ЭкранироватьАмперсанд,
		Настройки.ЭкранироватьОдинарныеКавычки,
		Настройки.ЭкранироватьКавычки);

КонецФункции

Функция НастройкиЗаписиJSON(СтрокаJSON)

	Результат = НастройкиЗаписиJSONПоУмолчанию();
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Сохраненные = JSONВЗначение(СтрокаJSON, Истина);
	Исключение
		Сохраненные = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Сохраненные) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	// Берутся только известные ключи и только значения того же типа, что по умолчанию.
	Настройки = Новый Структура;
	Для Каждого КлючИЗначение Из Результат Цикл
		Значение = Сохраненные.Получить(КлючИЗначение.Ключ);
		Если ТипЗнч(Значение) = ТипЗнч(КлючИЗначение.Значение) Тогда
			Настройки.Вставить(КлючИЗначение.Ключ, Значение);
		Иначе
			Настройки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Настройки.ФорматДаты <> ФорматДатыUnixTime() Тогда
		Настройки.ФорматДаты = ФорматДатыISO8601();
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция НастройкиЗаписиJSONПоУмолчанию()

	Результат = Новый Структура;
	Результат.Вставить("ПереносСтрок", "Авто");
	Результат.Вставить("СимволыОтступа", "");
	Результат.Вставить("ИспользоватьДвойныеКавычки", Истина);
	Результат.Вставить("ЭкранированиеСимволов", "Нет");
	Результат.Вставить("ЭкранироватьУгловыеСкобки", Истина);
	Результат.Вставить("ЭкранироватьРазделительСтрок", Истина);
	Результат.Вставить("ЭкранироватьАмперсанд", Истина);
	Результат.Вставить("ЭкранироватьОдинарныеКавычки", Истина);
	Результат.Вставить("ЭкранироватьКавычки", Истина);
	Результат.Вставить("ФорматДаты", ФорматДатыISO8601());

	Возврат Результат;

КонецФункции

Функция УпрощенныйXMLИзСтруктуры(Значение)

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписатьУзелXML(ЗаписьXML, "root", Значение);

	Возврат ЗаписьXML.Закрыть();

КонецФункции

Процедура ЗаписатьУзелXML(ЗаписьXML, Имя, Значение)

	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			ЗаписатьУзелXML(ЗаписьXML, Строка(КлючИЗначение.Ключ), КлючИЗначение.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьУзелXML(ЗаписьXML, "item", Элемент);
		КонецЦикла;
	Иначе
		ЗаписьXML.ЗаписатьТекст(Строка(Значение));
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура УстановитьЗаголовкиОтвета(Ответ, ДанныеНастройки)

	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимогоОтвета(ДанныеНастройки.ФорматОтвета));
	Ответ.Заголовки.Вставить("API-Version", ДанныеНастройки.ВерсияAPI);

КонецПроцедуры

Функция ТипСодержимогоОтвета(ФорматОтвета)

	Если ФорматОтвета = Перечисления.МС_ФорматОтветаAPI.XML Тогда
		Возврат "application/xml; charset=utf-8";
	КонецЕсли;

	Возврат "application/json; charset=utf-8";

КонецФункции

Функция ОтветОшибкиСервиса(КодHTTP, ТекстОшибки, ФорматОтвета, ВерсияAPI)

	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("error", Новый Структура("code, message", Строка(КодHTTP), ТекстОшибки));
	СтруктураОшибки.Вставить("apiVersion", ВерсияAPI);

	Если ФорматОтвета = Перечисления.МС_ФорматОтветаAPI.XML Тогда
		Тело = УпрощенныйXMLИзСтруктуры(СтруктураОшибки);
	Иначе
		Тело = ЗначениеВJSON(СтруктураОшибки);
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(КодHTTP);
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимогоОтвета(ФорматОтвета));

	Возврат Ответ;

КонецФункции

Функция JSONВЗначение(СтрокаJSON, ВСоответствие = Ложь)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, ВСоответствие);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

Функция ЗначениеВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область АдресПубликации

Функция АдресПубликацииИнформационнойБазы()

	Адрес = СокрЛП(ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети());
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Адрес = СокрЛП(ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете());
	КонецЕсли;
	// Константа адреса веб-клиента есть не во всех конфигурациях (например, есть в Документообороте, нет в ERP).
	ИмяКонстанты = "АдресПубликацииНаВебСервере";
	Если Не ЗначениеЗаполнено(Адрес) И Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);
		Адрес = СокрЛП(Константы[ИмяКонстанты].Получить());
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	// Адрес веб-клиента может заканчиваться на "/#" или "/ru_RU/" - для HTTP-сервиса они не нужны.
	Пока ЗначениеЗаполнено(Адрес) И (Прав(Адрес, 1) = "/" Или Прав(Адрес, 1) = "#") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	ПозицияСлеша = СтрНайти(Адрес, "/", НаправлениеПоиска.СКонца);
	Если ПозицияСлеша > 0 И ЭтоКодЛокализации(Сред(Адрес, ПозицияСлеша + 1)) Тогда
		Адрес = Лев(Адрес, ПозицияСлеша - 1);
	КонецЕсли;

	Возврат Адрес;

КонецФункции

Функция ЭтоКодЛокализации(Сегмент)
	
	// Сегмент вида "ru_RU".

	Возврат СтрДлина(Сегмент) = СтрДлина("ru_RU") И Сред(Сегмент, 3, 1) = "_";

КонецФункции

#КонецОбласти

#КонецОбласти
