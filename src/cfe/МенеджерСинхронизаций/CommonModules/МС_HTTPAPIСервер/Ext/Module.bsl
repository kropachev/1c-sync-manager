Функция РезультатЗапросаВМассивСтруктур(РезультатЗапроса)

	Колонки = РезультатЗапроса.Колонки;
	МассивЭлементов = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			Значение = Выборка[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
				Значение = РезультатЗапросаВМассивСтруктур(Значение);
			КонецЕсли;
			Элемент.Вставить(Колонка.Имя, Значение);
		КонецЦикла;
		МассивЭлементов.Добавить(Элемент);
	КонецЦикла;

	Возврат МассивЭлементов;

