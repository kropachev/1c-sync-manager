	Возврат Результат;

КонецФункции

Функция ОписанияПараметровПоИмени(ОбъектНастройки)

	Результат = Новый Соответствие;
	Для Каждого СтрокаПараметра Из ОбъектНастройки.ПараметрыЗапроса Цикл
		Имя = СокрЛП(СтрокаПараметра.ИмяПараметра);
		Если ЗначениеЗаполнено(Имя) Тогда
			Описание = Новый Структура("Обязательный, ТипПараметра, Источник, СпособСопоставления, Описание");
			ЗаполнитьЗначенияСвойств(Описание, СтрокаПараметра);
			Результат.Вставить(Имя, Описание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьПараметрыЗапросаПоОтборам(ОбъектНастройки, Отборы)
	
	// Отборы - коллекция элементов со свойствами Поле и ИмяПараметра (структуры или строки таблицы формы).

	СтарыеПараметры = ОписанияПараметровПоИмени(ОбъектНастройки);
	ИмяТаблицы = МС_HTTPAPIКонструкторСервер.ИмяТаблицыНастройки(ОбъектНастройки);

	ОбъектНастройки.ПараметрыЗапроса.Очистить();
	Добавленные = Новый Соответствие;
	Для Каждого Отбор Из Отборы Цикл
		// Строки с фиксированным значением параметр не создают: значение отбора задано в настройке.
		ИмяПараметра = МС_HTTPAPIКонструкторСервер.ИмяПараметраОтбора(Отбор);
		Если Не ЗначениеЗаполнено(ИмяПараметра) Или Добавленные.Получить(ИмяПараметра) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(ИмяПараметра, Истина);
		ДобавитьПараметрПоОтбору(ОбъектНастройки, ИмяПараметра, СокрЛП(Отбор.Поле), ИмяТаблицы,
			СтарыеПараметры.Получить(ИмяПараметра));
	КонецЦикла;

	// Параметр периода среза регистра сведений.
	ИмяПараметра = СокрЛП(ОбъектНастройки.КонструкторПараметрПериода);
	Если ЗначениеЗаполнено(ИмяПараметра) И Добавленные.Получить(ИмяПараметра) = Неопределено
		И ЗначениеЗаполнено(МС_HTTPAPIКонструкторСервер.ВиртуальнаяТаблицаНастройки(ОбъектНастройки, ИмяТаблицы)) Тогда
		ДобавитьПараметрПериода(ОбъектНастройки, ИмяПараметра, СтарыеПараметры.Получить(ИмяПараметра));
	КонецЕсли;

	СинхронизироватьТестовыеЗначенияСПараметрамиЗапроса(ОбъектНастройки);

КонецПроцедуры

Процедура ДобавитьПараметрПериода(ОбъектНастройки, ИмяПараметра, СтароеОписание)

	// Тип всегда ДАТА; признак "Обязательный" и собственное описание пользователя сохраняются.

	СтрокаПараметра = ОбъектНастройки.ПараметрыЗапроса.Добавить();
	СтрокаПараметра.ИмяПараметра = ИмяПараметра;
	СтрокаПараметра.ТипПараметра = "ДАТА";
	СтрокаПараметра.Описание = ПрефиксОписанияОтбора() + " период среза, не передан - текущие данные";

	Если СтароеОписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаПараметра.Обязательный = СтароеОписание.Обязательный;
	Если ЗначениеЗаполнено(СтароеОписание.Описание)
		И Не СтрНачинаетсяС(СтароеОписание.Описание, ПрефиксОписанияОтбора()) Тогда
		СтрокаПараметра.Описание = СтароеОписание.Описание;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПараметрПоОтбору(ОбъектНастройки, ИмяПараметра, Поле, ИмяТаблицы, СтароеОписание)
	
	// Тип и способ сопоставления берутся из метаданных поля; признак "Обязательный", источник,
	// выбранный пользователем способ и собственное описание сохраняются.

	СтрокаПараметра = ОбъектНастройки.ПараметрыЗапроса.Добавить();
	СтрокаПараметра.ИмяПараметра = ИмяПараметра;
	Если ЗначениеЗаполнено(Поле) Тогда
		ОписаниеТипов = МС_HTTPAPIКонструкторСервер.ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, Поле);
		СтрокаПараметра.Описание = ПрефиксОписанияОтбора() + " " + Поле;
		СтрокаПараметра.ТипПараметра = МС_HTTPAPIКонструкторСервер.КраткоеИмяТипаПараметраAPI(ОписаниеТипов);
		СтрокаПараметра.СпособСопоставления =
			МС_HTTPAPIКонструкторСервер.СпособСопоставленияПараметраОтбораПоУмолчанию(ОписаниеТипов);
	КонецЕсли;

	Если СтароеОписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтрокаПараметра, СтароеОписание, "Обязательный, Источник");
	Если ЗначениеЗаполнено(СтароеОписание.СпособСопоставления) Тогда
		СтрокаПараметра.СпособСопоставления = СтароеОписание.СпособСопоставления;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаПараметра.ТипПараметра) Тогда
		СтрокаПараметра.ТипПараметра = СтароеОписание.ТипПараметра;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтароеОписание.Описание)
		И Не СтрНачинаетсяС(СтароеОписание.Описание, ПрефиксОписанияОтбора()) Тогда
		СтрокаПараметра.Описание = СтароеОписание.Описание;
	КонецЕсли;

КонецПроцедуры

