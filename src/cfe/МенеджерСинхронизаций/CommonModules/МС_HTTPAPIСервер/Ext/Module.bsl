Функция ИзвлечьИмяПараметраЗапросаИзТекста(Текст, НачальнаяПозиция, ДлинаТекста)

	Если НачальнаяПозиция > ДлинаТекста
		Или Не СимволДопустимВИмениПараметраЗапроса(Сред(Текст, НачальнаяПозиция, 1), Истина) Тогда
		Возврат "";
	КонецЕсли;

	КонецПозиции = НачальнаяПозиция + 1;
	Пока КонецПозиции <= ДлинаТекста И СимволДопустимВИмениПараметраЗапроса(Сред(Текст, КонецПозиции, 1), Ложь) Цикл
		КонецПозиции = КонецПозиции + 1;
	КонецЦикла;

	Возврат Сред(Текст, НачальнаяПозиция, КонецПозиции - НачальнаяПозиция);

КонецФункции

Функция СимволДопустимВИмениПараметраЗапроса(Символ, ЭтоПервый)
	
	// Буквы (латиница, кириллица), подчеркивание; цифры - кроме первого символа.

	Если СтрНайти("0123456789", Символ) > 0 Тогда
		Возврат Не ЭтоПервый;
	КонецЕсли;

	Возврат Символ = "_" Или (ВРег(Символ) <> НРег(Символ));

