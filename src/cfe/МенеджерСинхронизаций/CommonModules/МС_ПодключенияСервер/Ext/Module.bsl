#Область ПрограммныйИнтерфейс

// Выполняет HTTP-запрос через уже созданное подключение и возвращает разобранный ответ.
// Заголовки накладываются в два слоя: сначала базовые из настройки подключения
// (СтруктураСоединения.Заголовки), затем ДополнительныеЗаголовки параметра вызова,
// перезаписывая по имени при совпадении.
//
// Перенаправления (301, 302, 303, 307, 308 с заголовком Location) выполняются повторным
// запросом по новому адресу, не более МаксимумПеренаправлений раз. Метод и тело сохраняются,
// кроме кода 303: по нему выполняется GET без тела. При переходе на другой сервер
// логин и пароль соединения, заголовки Authorization и Cookie не передаются.
// Исходное соединение в СтруктураСоединения не меняется.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   Метод - Строка - HTTP-метод: "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD".
//   Ресурс - Строка - путь ресурса относительно сервера, начинается с "/".
//                     Может содержать query-string.
//   ДополнительныеЗаголовки - Соответствие из КлючИЗначение:
//                              ** Ключ - Строка - имя заголовка;
//                              ** Значение - Строка.
//                             - Неопределено - не добавлять ничего сверх настройки.
//   Тело - Строка, ДвоичныеДанные, Неопределено - тело запроса. Строка отправляется в UTF-8.
//
// Возвращаемое значение:
//   Структура - см. НовыйОтветHTTP.
//
Функция ВыполнитьHTTPЗапрос(СтруктураСоединения, Метод, Ресурс, ДополнительныеЗаголовки = Неопределено, Тело = Неопределено) Экспорт

	Ответ = НовыйОтветHTTP();

	Если СтруктураСоединения = Неопределено Или СтруктураСоединения.Соединение = Неопределено Тогда
		Ответ.СтрокаОшибок = ?(СтруктураСоединения = Неопределено, "Соединение не передано",
			СтруктураСоединения.СтрокаОшибок);
		Возврат Ответ;
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Соединение", СтруктураСоединения.Соединение);
	ПараметрыЗапроса.Вставить("Метод", ВРег(Метод));
	ПараметрыЗапроса.Вставить("Ресурс", Ресурс);
	ПараметрыЗапроса.Вставить("Заголовки", ОбъединитьЗаголовки(СтруктураСоединения.Заголовки, ДополнительныеЗаголовки));
	ПараметрыЗапроса.Вставить("Тело", Тело);

	Попытка
		Ответ.ИтоговыйАдрес = АдресЗапроса(ПараметрыЗапроса);
		Ответ.ЦепочкаАдресов.Добавить(Ответ.ИтоговыйАдрес);

		Для НомерЗапроса = 1 По МаксимумПеренаправлений() + 1 Цикл

			РезультатHTTP = ОтправитьHTTPЗапрос(ПараметрыЗапроса);

			АдресПеренаправления = ЗначениеЗаголовка(РезультатHTTP.Заголовки, "Location");
			Если Не ЭтоКодПеренаправления(РезультатHTTP.КодСостояния)
				Или Не ЗначениеЗаполнено(АдресПеренаправления)
				Или НомерЗапроса > МаксимумПеренаправлений() Тогда
				Прервать;
			КонецЕсли;

			ПерейтиПоПеренаправлению(ПараметрыЗапроса, АдресПеренаправления, РезультатHTTP.КодСостояния);
			Ответ.ИтоговыйАдрес = АдресЗапроса(ПараметрыЗапроса);
			Ответ.ЦепочкаАдресов.Добавить(Ответ.ИтоговыйАдрес);

		КонецЦикла;

		Ответ.КодСостояния = РезультатHTTP.КодСостояния;
		Для Каждого КлючИЗначение Из РезультатHTTP.Заголовки Цикл
			Ответ.Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Ответ.Тело = РезультатHTTP.ПолучитьТелоКакДвоичныеДанные();
		Ответ.ТелоТекст = РезультатHTTP.ПолучитьТелоКакСтроку();

	Исключение
		Ответ.СтрокаОшибок = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

// Разбирает JSON из ответа HTTP в объекты платформы (Структура, Массив, Число, Строка, Булево, Неопределено).
//
// Параметры:
//   Ответ - см. НовыйОтветHTTP - результат вызова ВыполнитьHTTPЗапрос.
//
// Возвращаемое значение:
//   Произвольный - разобранное JSON-значение.
//                  Возвращает Неопределено, если тело пустое.
//
Функция ПрочитатьОтветJSON(Ответ) Экспорт

	Если Не ЗначениеЗаполнено(Ответ.ТелоТекст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ТелоТекст);
	Значение = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Разбирает XML из ответа HTTP в объект ДокументDOM для дальнейшей навигации.
//
// Параметры:
//   Ответ - см. НовыйОтветHTTP - результат вызова ВыполнитьHTTPЗапрос.
//
// Возвращаемое значение:
//   ДокументDOM, Неопределено - разобранный документ или Неопределено, если тело пустое.
//
Функция ПрочитатьОтветXML(Ответ) Экспорт

	Если Не ЗначениеЗаполнено(Ответ.ТелоТекст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Ответ.ТелоТекст);
	Построитель = Новый ПостроительDOM;
	Документ = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	Возврат Документ;

КонецФункции

// Конструктор пустой структуры-ответа HTTP.
//
// Возвращаемое значение:
//   Структура:
//     * КодСостояния - Число - HTTP status code (200, 404 и т.п.). 0 при ошибке транспорта.
//     * Заголовки - Соответствие из КлючИЗначение:
//         ** Ключ - Строка;
//         ** Значение - Строка.
//     * Тело - ДвоичныеДанные, Неопределено - тело ответа как двоичные данные.
//     * ТелоТекст - Строка - тело ответа как текст (использует кодировку из заголовков).
//     * СтрокаОшибок - Строка - текст ошибки транспорта, пустая строка при успехе.
//     * ИтоговыйАдрес - Строка - URL последнего выполненного запроса (после перенаправлений).
//     * ЦепочкаАдресов - Массив из Строка - URL всех выполненных запросов, начиная с исходного.
//                        Больше одного элемента - были перенаправления.
//
Функция НовыйОтветHTTP() Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", 0);
	Ответ.Вставить("Заголовки", Новый Соответствие);
	Ответ.Вставить("Тело", Неопределено);
	Ответ.Вставить("ТелоТекст", "");
	Ответ.Вставить("СтрокаОшибок", "");
	Ответ.Вставить("ИтоговыйАдрес", "");
	Ответ.Вставить("ЦепочкаАдресов", Новый Массив);
	Возврат Ответ;

КонецФункции

// Максимальное число перенаправлений, которые выполняет ВыполнитьHTTPЗапрос.
//
// Возвращаемое значение:
//   Число
//
Функция МаксимумПеренаправлений() Экспорт
	Возврат 10;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объединяет заголовки настройки подключения и заголовки вызова (вторые перезаписывают первые).
//
// Параметры:
//   ЗаголовкиНастройки - Соответствие из КлючИЗначение - заголовки из настройки подключения.
//   ДополнительныеЗаголовки - Соответствие из КлючИЗначение, Неопределено - заголовки вызова.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - новое соответствие.
//
Функция ОбъединитьЗаголовки(ЗаголовкиНастройки, ДополнительныеЗаголовки)

	Заголовки = Новый Соответствие;
	Для Каждого КлючИЗначение Из ЗаголовкиНастройки Цикл
		Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Если ДополнительныеЗаголовки <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ДополнительныеЗаголовки Цикл
			Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Заголовки;

КонецФункции

// Отправляет один HTTP-запрос без обработки перенаправлений.
//
// Параметры:
//   ПараметрыЗапроса - Структура - см. ВыполнитьHTTPЗапрос:
//     * Соединение - HTTPСоединение - соединение с сервером.
//     * Метод - Строка - HTTP-метод в верхнем регистре.
//     * Ресурс - Строка - путь ресурса относительно сервера.
//     * Заголовки - Соответствие из КлючИЗначение - заголовки запроса.
//     * Тело - Строка, ДвоичныеДанные, Неопределено - тело запроса. Строка отправляется в UTF-8.
//
// Возвращаемое значение:
//   HTTPОтвет
//
Функция ОтправитьHTTPЗапрос(ПараметрыЗапроса)

	Запрос = Новый HTTPЗапрос(ПараметрыЗапроса.Ресурс);
	Для Каждого КлючИЗначение Из ПараметрыЗапроса.Заголовки Цикл
		Запрос.Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Тело = ПараметрыЗапроса.Тело;
	Если Тело <> Неопределено Тогда
		Если ТипЗнч(Тело) = Тип("Строка") Тогда
			Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
		Иначе
			Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
		КонецЕсли;
	КонецЕсли;

	Возврат ПараметрыЗапроса.Соединение.ВызватьHTTPМетод(ПараметрыЗапроса.Метод, Запрос);

КонецФункции

// Меняет параметры запроса для перехода по перенаправлению: ресурс, при смене сервера,
// порта или схемы - соединение, при смене сервера - убирает заголовки авторизации,
// при коде 303 - метод на GET без тела.
//
// Параметры:
//   ПараметрыЗапроса - Структура - см. ОтправитьHTTPЗапрос - изменяется.
//   АдресПеренаправления - Строка - значение заголовка Location.
//   КодСостояния - Число - код ответа с перенаправлением.
//
Процедура ПерейтиПоПеренаправлению(ПараметрыЗапроса, АдресПеренаправления, КодСостояния)

	Соединение = ПараметрыЗапроса.Соединение;
	Цель = РазобратьАдресПеренаправления(АдресПеренаправления, Соединение, ПараметрыЗапроса.Ресурс);

	ДругойСервер = (НРег(Цель.Сервер) <> НРег(Соединение.Сервер));
	Если ДругойСервер Тогда
		УдалитьЗаголовкиАвторизации(ПараметрыЗапроса.Заголовки);
	КонецЕсли;
	Если ДругойСервер Или Цель.Порт <> Соединение.Порт
		Или Цель.ИспользоватьSSL <> ЭтоЗащищенноеСоединение(Соединение) Тогда
		ПараметрыЗапроса.Соединение = НовоеСоединениеПеренаправления(Соединение, Цель, ДругойСервер);
	КонецЕсли;

	Если КодСостояния = 303 И ПараметрыЗапроса.Метод <> "HEAD" Тогда
		ПараметрыЗапроса.Метод = "GET";
		ПараметрыЗапроса.Тело = Неопределено;
	КонецЕсли;
	ПараметрыЗапроса.Ресурс = Цель.Ресурс;

КонецПроцедуры

// Формирует URL текущего запроса для показа пользователю.
//
// Параметры:
//   ПараметрыЗапроса - Структура - см. ОтправитьHTTPЗапрос.
//
// Возвращаемое значение:
//   Строка
//
Функция АдресЗапроса(ПараметрыЗапроса)
	Соединение = ПараметрыЗапроса.Соединение;
	Возврат АдресHTTP(Соединение.Сервер, Соединение.Порт, ЭтоЗащищенноеСоединение(Соединение),
		ПараметрыЗапроса.Ресурс);
КонецФункции

// Проверяет, что код ответа означает перенаправление на адрес из заголовка Location.
//
// Параметры:
//   КодСостояния - Число - HTTP status code.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоКодПеренаправления(КодСостояния)
	Возврат КодСостояния = 301 Или КодСостояния = 302 Или КодСостояния = 303
		Или КодСостояния = 307 Или КодСостояния = 308;
КонецФункции

// Возвращает значение заголовка без учета регистра имени (HTTP/2 передает имена в нижнем регистре).
//
// Параметры:
//   Заголовки - Соответствие из КлючИЗначение - заголовки ответа.
//   Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//   Строка - значение заголовка, пустая строка если заголовка нет.
//
Функция ЗначениеЗаголовка(Заголовки, Имя)

	ИмяНРег = НРег(Имя);
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = ИмяНРег Тогда
			Возврат СокрЛП(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Удаляет заголовки, которые нельзя передавать на другой сервер.
//
// Параметры:
//   Заголовки - Соответствие из КлючИЗначение - заголовки запроса, изменяются.
//
Процедура УдалитьЗаголовкиАвторизации(Заголовки)

	ЗапрещенныеИмена = СтрРазделить("authorization,cookie", ",");
	УдаляемыеКлючи = Новый Массив;
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если ЗапрещенныеИмена.Найти(НРег(КлючИЗначение.Ключ)) <> Неопределено Тогда
			УдаляемыеКлючи.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из УдаляемыеКлючи Цикл
		Заголовки.Удалить(Ключ);
	КонецЦикла;

КонецПроцедуры

// Разбирает значение заголовка Location относительно текущего запроса.
// Поддерживаются абсолютный URL (http://, https://), URL без схемы (//сервер/путь),
// абсолютный путь (/путь) и относительный путь (путь).
//
// Параметры:
//   Адрес - Строка - значение заголовка Location.
//   Соединение - HTTPСоединение - соединение, которое вернуло перенаправление.
//   ТекущийРесурс - Строка - ресурс запроса, который вернул перенаправление.
//
// Возвращаемое значение:
//   Структура:
//     * Сервер - Строка - имя хоста.
//     * Порт - Число - порт.
//     * ИспользоватьSSL - Булево - требуется HTTPS.
//     * Ресурс - Строка - путь с query-string, начинается с "/".
//
Функция РазобратьАдресПеренаправления(Адрес, Соединение, ТекущийРесурс)

	Результат = Новый Структура;
	Результат.Вставить("Сервер", Соединение.Сервер);
	Результат.Вставить("Порт", Соединение.Порт);
	Результат.Вставить("ИспользоватьSSL", ЭтоЗащищенноеСоединение(Соединение));
	Результат.Вставить("Ресурс", "/");

	АдресНРег = НРег(Адрес);
	Если СтрНачинаетсяС(АдресНРег, "https://") Тогда
		Результат.ИспользоватьSSL = Истина;
		РазобратьСерверИРесурс(Сред(Адрес, 9), Результат);
	ИначеЕсли СтрНачинаетсяС(АдресНРег, "http://") Тогда
		Результат.ИспользоватьSSL = Ложь;
		РазобратьСерверИРесурс(Сред(Адрес, 8), Результат);
	ИначеЕсли СтрНачинаетсяС(Адрес, "//") Тогда
		РазобратьСерверИРесурс(Сред(Адрес, 3), Результат);
	ИначеЕсли СтрНачинаетсяС(Адрес, "/") Тогда
		Результат.Ресурс = Адрес;
	Иначе
		// Относительный путь отсчитывается от каталога текущего ресурса, query-string отбрасывается.
		Путь = ТекущийРесурс;
		ПозицияЗапроса = СтрНайти(Путь, "?");
		Если ПозицияЗапроса > 0 Тогда
			Путь = Лев(Путь, ПозицияЗапроса - 1);
		КонецЕсли;
		Каталог = Лев(Путь, СтрНайти(Путь, "/", НаправлениеПоиска.СКонца));
		Если Не СтрНачинаетсяС(Каталог, "/") Тогда
			Каталог = "/" + Каталог;
		КонецЕсли;
		Результат.Ресурс = Каталог + Адрес;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заполняет сервер, порт и ресурс из части URL после схемы.
//
// Параметры:
//   СерверИРесурс - Строка - URL без схемы, например "host:8443/path?q=1".
//   Результат - см. РазобратьАдресПеренаправления - изменяется. Поле ИспользоватьSSL
//               должно быть заполнено до вызова: от него зависит порт по умолчанию.
//
Процедура РазобратьСерверИРесурс(СерверИРесурс, Результат)

	ПозицияСлеша = СтрНайти(СерверИРесурс, "/");
	Если ПозицияСлеша = 0 Тогда
		СерверИПорт = СерверИРесурс;
		Результат.Ресурс = "/";
	Иначе
		СерверИПорт = Лев(СерверИРесурс, ПозицияСлеша - 1);
		Результат.Ресурс = Сред(СерверИРесурс, ПозицияСлеша);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(СерверИПорт, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(СерверИПорт, ПозицияДвоеточия - 1);
		Результат.Порт = Число(Сред(СерверИПорт, ПозицияДвоеточия + 1));
	Иначе
		Результат.Сервер = СерверИПорт;
		Результат.Порт = ?(Результат.ИспользоватьSSL, 443, 80);
	КонецЕсли;

КонецПроцедуры

// Создает соединение для перехода по перенаправлению с параметрами исходного соединения.
//
// Параметры:
//   Соединение - HTTPСоединение - соединение, которое вернуло перенаправление.
//   Цель - см. РазобратьАдресПеренаправления.
//   ДругойСервер - Булево - Истина: логин и пароль исходного соединения не передаются.
//
// Возвращаемое значение:
//   HTTPСоединение
//
Функция НовоеСоединениеПеренаправления(Соединение, Цель, ДругойСервер)

	Пользователь = ?(ДругойСервер, "", Соединение.Пользователь);
	Пароль = ?(ДругойСервер, "", Соединение.Пароль);
	ЗащищенноеСоединение = ?(Цель.ИспользоватьSSL, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);

	Возврат Новый HTTPСоединение(Цель.Сервер, Цель.Порт, Пользователь, Пароль,
		Соединение.Прокси, Соединение.Таймаут, ЗащищенноеСоединение);

КонецФункции

// Проверяет, что соединение работает по HTTPS.
//
// Параметры:
//   Соединение - HTTPСоединение
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЗащищенноеСоединение(Соединение)
	Возврат Соединение.ЗащищенноеСоединение <> Неопределено И Соединение.ЗащищенноеСоединение <> Ложь;
КонецФункции

// Формирует URL для показа пользователю. Порт по умолчанию для схемы не выводится.
//
// Параметры:
//   Сервер - Строка - имя хоста.
//   Порт - Число - порт.
//   ИспользоватьSSL - Булево - HTTPS.
//   Ресурс - Строка - путь ресурса.
//
// Возвращаемое значение:
//   Строка
//
Функция АдресHTTP(Сервер, Порт, ИспользоватьSSL, Ресурс)

	ПортПоУмолчанию = ?(ИспользоватьSSL, 443, 80);
	ПредставлениеПорта = ?(Не ЗначениеЗаполнено(Порт) Или Порт = ПортПоУмолчанию, "", ":" + Формат(Порт, "ЧГ=0"));
	Возврат ?(ИспользоватьSSL, "https://", "http://") + Сервер + ПредставлениеПорта + Ресурс;

КонецФункции

#КонецОбласти
