// Универсальный транспорт RabbitMQ Management HTTP API для конвейера МенеджерСинхронизаций.
// Прикладной логики не содержит: что делать с полученными сообщениями, какие сообщения отправлять
// и куда записывать историю обмена, решает прикладной код (процедуры подготовки и обработки данных запроса).
// Операции транспорта (полученные и отправленные сообщения, ошибки) пишутся в журнал обмена МС_ЖурналОбмена,
// см. МС_ЖурналОбменаСервер. Операции: RabbitMQ.Получение, RabbitMQ.Отправка.
//
// Настройка подключения (МС_НастройкиПодключений, вид HTTP): в поле Сервер указывается корень
// Management API, например https://rabbitmq.example.com/api. Путь из адреса передается
// в СтруктураСоединения.БазовыйПуть.
//
// Настройка запроса (МС_ЗапросыКВнешнимИсточникам, СпособЗапросаДанных = "RabbitMQ"): параметры очереди -
// реквизиты запроса ИмяОчереди, ВиртуальныйХост, КоличествоСообщений, УдалятьСообщенияПослеПрочтения,
// ТочкаОбмена. Загрузка вызывает ПолучитьСообщения, выгрузка - ОпубликоватьСообщенияВыгрузки.
//
// ВиртуальныйХост: пустой, если vhost задан в базовом пути (прокси перед RabbitMQ), "/" - vhost по умолчанию.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Забирает пачку сообщений из очереди (POST {БазовыйПуть}/queues/[{vhost}/]{очередь}/get).
// Каждое полученное сообщение и ошибки пишутся в журнал обмена. Пустое чтение не журналируется.
// Результат запроса (успех, адрес, код ответа, ошибка) помещается в СтруктураПараметров.РезультатПолученияRabbitMQ,
// чтобы процедура обработки могла его записать. При ошибке возвращается пустой массив: конвейер вызывает
// процедуру обработки и в этом случае.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   СтруктураПараметров - Структура - параметры обмена МС.
//
// Возвращаемое значение:
//   Массив из Структура - сообщения RabbitMQ: payload (Строка), routing_key, redelivered и т.д.
//                         Пустой массив, если очередь пуста или запрос завершился ошибкой.
//
Функция ПолучитьСообщения(СтруктураСоединения, СтруктураПараметров) Экспорт

	ИмяОчереди = СокрЛП(СтруктураПараметров.ИмяОчереди);
	ВиртуальныйХост = СокрЛП(СтруктураПараметров.ВиртуальныйХост);
	Результат = НовыйРезультатЗапроса(ИмяОчереди, "RabbitMQ.Получение");
	СтруктураПараметров.Вставить("РезультатПолученияRabbitMQ", Результат);
	Сообщения = Новый Массив;

	Если Не ЗначениеЗаполнено(ИмяОчереди) Тогда
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Не задано имя очереди.");
		Возврат Сообщения;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("count", ?(ЗначениеЗаполнено(СтруктураПараметров.КоличествоСообщений),
		СтруктураПараметров.КоличествоСообщений, 10));
	Тело.Вставить("ackmode", ?(СтруктураПараметров.УдалятьСообщенияПослеПрочтения,
		"ack_requeue_false", "ack_requeue_true"));
	Тело.Вставить("encoding", "auto");
	Если ЗначениеЗаполнено(ВиртуальныйХост) Тогда
		Тело.Вставить("vhost", ВиртуальныйХост);
		Тело.Вставить("name", ИмяОчереди);
	КонецЕсли;

	Ресурс = РесурсОбъектаRabbitMQ(СтруктураСоединения, "queues", ВиртуальныйХост, ИмяОчереди)
		+ "/get";
	Ответ = ВыполнитьЗапросJSON(СтруктураСоединения, "POST", Ресурс, Тело);
	Результат.Адрес = Ответ.ИтоговыйАдрес;
	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.ТелоОтвета = Ответ.ТелоТекст;

	Если ЗначениеЗаполнено(Ответ.СтрокаОшибок) Или Ответ.КодСостояния <> 200 Тогда
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Ошибка чтения очереди. " + Ответ.СтрокаОшибок);
		Возврат Сообщения;
	КонецЕсли;

	Попытка
		Прочитано = МС_ПодключенияСервер.ПрочитатьОтветJSON(Ответ);
	Исключение
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Ошибка разбора ответа очереди. "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Сообщения;
	КонецПопытки;

	Если ТипЗнч(Прочитано) = Тип("Массив") Тогда
		Сообщения = Прочитано;
	КонецЕсли;
	Результат.Успешно = Истина;

	Для Каждого Сообщение Из Сообщения Цикл
		Payload = "";
		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Сообщение.Свойство("payload", Payload);
		КонецЕсли;
		МС_ЖурналОбменаСервер.ДобавитьЗапись(СтруктураПараметров, Перечисления.МС_УровниЖурналаОбмена.Информация,
			"Получено сообщение из очереди " + ИмяОчереди + ". " + ОписаниеЗапроса(Результат),
			Результат.Операция, Payload);
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// Публикует одно сообщение через точку обмена (exchange) RabbitMQ:
// POST {БазовыйПуть}/exchanges/[{vhost}/]{точка обмена}/publish,
// routing_key - имя очереди. Точка обмена по умолчанию amq.default доставляет сообщение в очередь с именем,
// равным routing_key.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   СтруктураПараметров - Структура - параметры обмена МС.
//   ТекстСообщения - Строка - текст сообщения (payload), отправляется как есть.
//                  - Неопределено - текст из поля "Текст сообщения" запроса (реквизит ТекстЗапроса).
//   Заголовки - Структура, Соответствие - заголовки AMQP сообщения (properties.headers).
//             - Неопределено - без заголовков.
//
// Возвращаемое значение:
//   Структура - см. НовыйРезультатЗапроса. Успешно = Истина, если RabbitMQ доставил сообщение
//               в очередь (routed = true). Дополнительно поле ТекстСообщения - отправленный текст.
//
Функция ОпубликоватьСообщение(СтруктураСоединения, СтруктураПараметров, ТекстСообщения = Неопределено,
	Заголовки = Неопределено) Экспорт

	ИмяОчереди = СокрЛП(СтруктураПараметров.ИмяОчереди);
	ВиртуальныйХост = СокрЛП(СтруктураПараметров.ВиртуальныйХост);
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = "";
		СтруктураПараметров.Свойство("ТекстЗапроса", ТекстСообщения);
	КонецЕсли;

	Результат = НовыйРезультатЗапроса(ИмяОчереди, "RabbitMQ.Отправка");
	Результат.Вставить("ТекстСообщения", ТекстСообщения);

	Если Не ЗначениеЗаполнено(ИмяОчереди) Тогда
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Не задано имя очереди.");
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Не задан текст сообщения.");
		Возврат Результат;
	КонецЕсли;

	// Пустая точка обмена - amq.default: доставляет сообщение в очередь с именем, равным routing_key
	ТочкаОбмена = СокрЛП(СтруктураПараметров.ТочкаОбмена);
	Если Не ЗначениеЗаполнено(ТочкаОбмена) Тогда
		ТочкаОбмена = "amq.default";
	КонецЕсли;

	Свойства = Новый Структура("delivery_mode, content_type", 2, "application/json");
	Если Заголовки <> Неопределено Тогда
		Свойства.Вставить("headers", Заголовки);
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("properties", Свойства);
	Тело.Вставить("routing_key", ИмяОчереди);
	Тело.Вставить("payload", ТекстСообщения);
	Тело.Вставить("payload_encoding", "string");
	Если ЗначениеЗаполнено(ВиртуальныйХост) Тогда
		Тело.Вставить("vhost", ВиртуальныйХост);
		Тело.Вставить("name", ТочкаОбмена);
	КонецЕсли;

	Ресурс = РесурсОбъектаRabbitMQ(СтруктураСоединения, "exchanges", ВиртуальныйХост, ТочкаОбмена)
		+ "/publish";
	Ответ = ВыполнитьЗапросJSON(СтруктураСоединения, "POST", Ресурс, Тело);
	Результат.Адрес = Ответ.ИтоговыйАдрес;
	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.ТелоОтвета = Ответ.ТелоТекст;

	Если ЗначениеЗаполнено(Ответ.СтрокаОшибок) Или Ответ.КодСостояния <> 200 Тогда
		ЗафиксироватьОшибку(СтруктураПараметров, Результат, "Ошибка публикации. " + Ответ.СтрокаОшибок);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ОтветRabbitMQ = МС_ПодключенияСервер.ПрочитатьОтветJSON(Ответ);
		Результат.Успешно = ТипЗнч(ОтветRabbitMQ) = Тип("Структура")
			И ОтветRabbitMQ.Свойство("routed") И ОтветRabbitMQ.routed = Истина;
	Исключение
		// Ответ не JSON: доставка не подтверждена, ошибка фиксируется ниже.
		Результат.Успешно = Ложь;
	КонецПопытки;

	Если Результат.Успешно Тогда
		МС_ЖурналОбменаСервер.ДобавитьЗапись(СтруктураПараметров, Перечисления.МС_УровниЖурналаОбмена.Информация,
			"Сообщение отправлено в очередь " + ИмяОчереди + ". " + ОписаниеЗапроса(Результат),
			Результат.Операция, ТекстСообщения);
	Иначе
		ЗафиксироватьОшибку(СтруктураПараметров, Результат,
			"Сообщение не доставлено: очереди с таким именем нет или она недоступна.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выгрузка МС (СпособЗапросаДанных = "RabbitMQ", ТипОбмена = Выгрузка): публикует сообщения,
// подготовленные прикладным кодом в СтруктураПараметров.РезультатВыгрузки (массив выгрузки конвейера).
// Элемент массива - строка (текст сообщения) или структура с полями:
//   * ТекстСообщения - Строка - текст сообщения (payload);
//   * Заголовки - Структура, Соответствие - необязательное, заголовки AMQP сообщения.
// В структуру после отправки добавляются поля ОтправленоУспешно (Булево), РезультатОтправки
// (см. ОпубликоватьСообщение) и ЗапросОтправки (запрос строки, которая отправила сообщение), по ним
// процедура обработки выгрузки узнает результат по каждому своему сообщению. Строковый элемент при отправке
// заменяется такой структурой.
// Массив выгрузки общий для всех строк запуска, поэтому публикуются только элементы, которые еще никто
// не отправлял (без поля РезультатОтправки): сообщение, отправленное одной строкой выгрузки, следующая
// строка в свою очередь не дублирует.
// Если неотправленных элементов нет, публикуется текст из поля "Текст сообщения" запроса, а если и он
// пуст - ничего не отправляется, в журнал обмена пишется запись "Нет сообщений для отправки".
// Возвращаемый массив конвейер передает процедуре обработки четвертым параметром.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   СтруктураПараметров - Структура - параметры обмена МС.
//
// Возвращаемое значение:
//   Массив из см. ОпубликоватьСообщение - результаты отправки по каждому сообщению.
//
Функция ОпубликоватьСообщенияВыгрузки(СтруктураСоединения, СтруктураПараметров) Экспорт

	Результаты = Новый Массив;

	Сообщения = Неопределено;
	СтруктураПараметров.Свойство("РезультатВыгрузки", Сообщения);
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Сообщения = Новый Массив;
	КонецЕсли;

	Запрос = Неопределено;
	СтруктураПараметров.Свойство("НастройкаЗагрузки", Запрос);

	Для Индекс = 0 По Сообщения.ВГраница() Цикл
		Элемент = Сообщения[Индекс];
		Если ТипЗнч(Элемент) = Тип("Структура") Тогда
			Если Элемент.Свойство("РезультатОтправки") Тогда
				// Уже отправлено другой строкой выгрузки этого запуска.
				Продолжить;
			КонецЕсли;
		Иначе
			Элемент = Новый Структура("ТекстСообщения", Строка(Элемент));
			Сообщения[Индекс] = Элемент;
		КонецЕсли;
		ТекстСообщения = "";
		Заголовки = Неопределено;
		Элемент.Свойство("ТекстСообщения", ТекстСообщения);
		Элемент.Свойство("Заголовки", Заголовки);
		Результат = ОпубликоватьСообщение(СтруктураСоединения, СтруктураПараметров, Строка(ТекстСообщения),
			Заголовки);
		Элемент.Вставить("ОтправленоУспешно", Результат.Успешно);
		Элемент.Вставить("РезультатОтправки", Результат);
		Элемент.Вставить("ЗапросОтправки", Запрос);
		Результаты.Добавить(Результат);
	КонецЦикла;

	Если Результаты.Количество() = 0 Тогда
		ТекстЗапроса = "";
		СтруктураПараметров.Свойство("ТекстЗапроса", ТекстЗапроса);
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Результаты.Добавить(ОпубликоватьСообщение(СтруктураСоединения, СтруктураПараметров));
		Иначе
			// Запуск без отправки тоже виден в журнале: запрос выполнен, но отправлять было нечего.
			ИмяОчереди = "";
			СтруктураПараметров.Свойство("ИмяОчереди", ИмяОчереди);
			МС_ЖурналОбменаСервер.ДобавитьЗапись(СтруктураПараметров, Перечисления.МС_УровниЖурналаОбмена.Информация,
				"Нет сообщений для отправки в очередь " + ИмяОчереди
					+ ": процедура подготовки и предыдущие строки запуска не подготовили новых сообщений,"
					+ " текст сообщения в запросе не заполнен.", "RabbitMQ.Отправка");
		КонецЕсли;
	КонецЕсли;

	Возврат Результаты;

КонецФункции

// Конструктор результата запроса к RabbitMQ.
//
// Параметры:
//   ИмяОчереди - Строка - очередь запроса.
//   Операция - Строка - операция для журнала обмена: RabbitMQ.Получение, RabbitMQ.Отправка.
//
// Возвращаемое значение:
//   Структура:
//     * Успешно - Булево - запрос выполнен (для публикации - сообщение доставлено в очередь).
//     * ИмяОчереди - Строка - очередь запроса.
//     * Операция - Строка - операция для журнала обмена.
//     * Адрес - Строка - URL запроса (после перенаправлений).
//     * КодСостояния - Число - HTTP-код ответа, 0 - ошибка транспорта или запрос не выполнялся.
//     * ТекстОшибки - Строка - описание ошибки, пустая строка при успехе.
//     * ТелоОтвета - Строка - тело ответа RabbitMQ.
//
Функция НовыйРезультатЗапроса(ИмяОчереди = "", Операция = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ИмяОчереди", ИмяОчереди);
	Результат.Вставить("Операция", Операция);
	Результат.Вставить("Адрес", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТелоОтвета", "");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует путь объекта Management API: {БазовыйПуть}/{коллекция}/[{vhost}/]{имя}.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   Коллекция - Строка - "queues" или "exchanges".
//   ВиртуальныйХост - Строка - пустой, если vhost задан в базовом пути.
//   Имя - Строка - имя очереди или точки обмена.
//
// Возвращаемое значение:
//   Строка
//
Функция РесурсОбъектаRabbitMQ(СтруктураСоединения, Коллекция, ВиртуальныйХост, Имя)

	БазовыйПуть = "";
	СтруктураСоединения.Свойство("БазовыйПуть", БазовыйПуть);
	Ресурс = СокрЛП(БазовыйПуть) + "/" + Коллекция + "/";
	Если ЗначениеЗаполнено(ВиртуальныйХост) Тогда
		Ресурс = Ресурс + КодироватьСтроку(ВиртуальныйХост, СпособКодированияСтроки.КодировкаURL) + "/";
	КонецЕсли;
	Возврат Ресурс + КодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Выполняет запрос с JSON-телом и заголовком Content-Type: application/json.
//
// Параметры:
//   СтруктураСоединения - Структура - см. Справочники.МС_НастройкиПодключений.НовоеСоединение.
//   Метод - Строка - HTTP-метод.
//   Ресурс - Строка - путь ресурса.
//   Данные - Структура - тело запроса.
//
// Возвращаемое значение:
//   Структура - см. МС_ПодключенияСервер.НовыйОтветHTTP.
//
Функция ВыполнитьЗапросJSON(СтруктураСоединения, Метод, Ресурс, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТелоЗапроса = Запись.Закрыть();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	Возврат МС_ПодключенияСервер.ВыполнитьHTTPЗапрос(СтруктураСоединения, Метод, Ресурс, Заголовки, ТелоЗапроса);

КонецФункции

// Помечает результат ошибочным и пишет ошибку в журнал обмена.
//
// Параметры:
//   СтруктураПараметров - Структура - параметры обмена МС, см. МС_ЖурналОбменаСервер.ДобавитьЗапись.
//   Результат - см. НовыйРезультатЗапроса - изменяется.
//   ТекстОшибки - Строка - описание ошибки.
//
Процедура ЗафиксироватьОшибку(СтруктураПараметров, Результат, ТекстОшибки)

	Результат.Успешно = Ложь;
	Результат.ТекстОшибки = СокрЛП(ТекстОшибки);

	ДанныеСообщения = Результат.ТелоОтвета;
	Если Результат.Свойство("ТекстСообщения") И ЗначениеЗаполнено(Результат.ТекстСообщения) Тогда
		ДанныеСообщения = Результат.ТекстСообщения;
	КонецЕсли;
	МС_ЖурналОбменаСервер.ДобавитьЗапись(СтруктураПараметров, Перечисления.МС_УровниЖурналаОбмена.Ошибка,
		"Очередь " + Результат.ИмяОчереди + ": " + Результат.ТекстОшибки + " " + ОписаниеЗапроса(Результат)
			+ " " + Лев(Результат.ТелоОтвета, 1000),
		Результат.Операция, ДанныеСообщения);

КонецПроцедуры

// Адрес и код ответа запроса для текста записи журнала.
//
// Параметры:
//   Результат - см. НовыйРезультатЗапроса.
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеЗапроса(Результат)
	Возврат СтрШаблон("Адрес: %1, код ответа %2.", Результат.Адрес, Формат(Результат.КодСостояния, "ЧН=0; ЧГ=0"));
КонецФункции

#КонецОбласти

#КонецЕсли
