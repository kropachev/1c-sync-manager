
#Область ПрограммныйИнтерфейс

// Строит полное имя таблицы запроса по полям мастера конструктора.
//
// Параметры:
//  ТипИсточника - ПеречислениеСсылка.МС_ТипИсточникаКонструктораAPI - вид объекта метаданных.
//  ИмяОбъекта - Строка - имя объекта метаданных.
//  ИмяТабличнойЧасти - Строка - имя табличной части (учитывается для справочника и документа).
//
// Возвращаемое значение:
//  Строка - например, "Документ.Заказ.ТабличнаяЧасть.Товары"; пустая строка, если имя не определено.
//
Функция ПолноеИмяТаблицыЗапроса(Знач ТипИсточника, Знач ИмяОбъекта, Знач ИмяТабличнойЧасти) Экспорт

	Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;

	ВидОбъекта = ВидыОбъектовМетаданныхПоТипуИсточника().Получить(ТипИсточника);
	Если Не ЗначениеЗаполнено(ВидОбъекта) Тогда
		Возврат "";
	КонецЕсли;

	ПолноеИмя = ВидОбъекта + "." + ИмяОбъекта;
	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) И ТипИсточникаСТабличнымиЧастями(ТипИсточника) Тогда
		ПолноеИмя = ПолноеИмя + "." + ИмяКоллекцииТабличныхЧастей() + "." + ИмяТабличнойЧасти;
	КонецЕсли;

	Возврат ПолноеИмя;

КонецФункции

// Имя таблицы запроса настройки: по полям мастера, а если они не заданы - сохраненное КонструкторИмяТаблицы.
//
// Параметры:
//  ОбъектНастройки - СправочникОбъект.МС_НастройкиAPI, ДанныеФормыСтруктура - настройка API.
//
// Возвращаемое значение:
//  Строка - полное имя таблицы или пустая строка.
//
Функция ИмяТаблицыНастройки(ОбъектНастройки) Экспорт

	ИмяТаблицы = ПолноеИмяТаблицыЗапроса(
		ОбъектНастройки.КонструкторТипИсточника,
		ОбъектНастройки.КонструкторИмяОбъекта,
		ОбъектНастройки.КонструкторИмяТабличнойЧасти);
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ИмяТаблицы = СокрЛП(ОбъектНастройки.КонструкторИмяТаблицы);
	КонецЕсли;

	Возврат ИмяТаблицы;

КонецФункции

// Список объектов метаданных указанного вида для выбора в мастере.
//
// Параметры:
//  ТипИсточника - ПеречислениеСсылка.МС_ТипИсточникаКонструктораAPI - вид объекта метаданных.
//
// Возвращаемое значение:
//  Массив из Структура - отсортированный по представлению список:
//   * Имя - Строка - имя объекта метаданных;
//   * Представление - Строка - синоним объекта.
//
Функция СписокОбъектовПоТипу(Знач ТипИсточника) Экспорт

	Результат = Новый Массив;
	Для Каждого ОбъектМД Из КоллекцияМетаданныхПоТипуИсточника(ТипИсточника) Цикл
		Результат.Добавить(Новый Структура("Имя, Представление", ОбъектМД.Имя, ОбъектМД.Представление()));
	КонецЦикла;

	Возврат ОтсортированныйПоПредставлению(Результат);

КонецФункции

// Список табличных частей справочника или документа для выбора в мастере.
//
// Параметры:
//  ТипИсточника - ПеречислениеСсылка.МС_ТипИсточникаКонструктораAPI - вид объекта метаданных.
//  ИмяОбъекта - Строка - имя объекта метаданных.
//
// Возвращаемое значение:
//  Массив из Структура - отсортированный по представлению список:
//   * Имя - Строка - имя табличной части;
//   * Представление - Строка - синоним табличной части.
//
Функция СписокТабличныхЧастей(Знач ТипИсточника, Знач ИмяОбъекта) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ИмяОбъекта) Или Не ТипИсточникаСТабличнымиЧастями(ТипИсточника) Тогда
		Возврат Результат;
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТаблицыЗапроса(ТипИсточника, ИмяОбъекта, ""));
	Если ОбъектМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
		Результат.Добавить(Новый Структура("Имя, Представление", ТабличнаяЧасть.Имя, ТабличнаяЧасть.Представление()));
	КонецЦикла;

	Возврат ОтсортированныйПоПредставлению(Результат);

КонецФункции

// Поля таблицы запроса, доступные в конструкторе.
//
// Параметры:
//  ПолноеИмяТаблицы - Строка - полное имя таблицы, см. ПолноеИмяТаблицыЗапроса.
//
// Возвращаемое значение:
//  Массив из Структура - пустой, если таблица не найдена:
//   * Имя - Строка - имя поля;
//   * Представление - Строка - синоним поля;
//   * Тип - ОписаниеТипов - тип поля.
//
Функция ПоляТаблицыЗапроса(Знач ПолноеИмяТаблицы) Экспорт

	Поля = Новый Массив;
	Если Не ЗначениеЗаполнено(ПолноеИмяТаблицы) Тогда
		Возврат Поля;
	КонецЕсли;

	Части = СтрРазделить(ПолноеИмяТаблицы, ".");
	Если ЭтоИмяТабличнойЧасти(Части) Тогда
		ДобавитьПоляТабличнойЧасти(Поля, Части);
		Возврат Поля;
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТаблицы);
	Если ОбъектМД = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	ПолноеИмя = ОбъектМД.ПолноеИмя();
	Если СтрНачинаетсяС(ПолноеИмя, "РегистрСведений.") Тогда
		Если ЭтоПериодическийРегистрСведений(ОбъектМД) Тогда
			ДобавитьПоле(Поля, "Период", "Период", Новый ОписаниеТипов("Дата"));
		КонецЕсли;
		ДобавитьПоляКоллекции(Поля, ОбъектМД.Измерения);
		ДобавитьПоляКоллекции(Поля, ОбъектМД.Ресурсы);
	Иначе
		ДобавитьПоле(Поля, "Ссылка", "Ссылка", ОписаниеТипаСсылки(ПолноеИмя));
		ДобавитьСтандартныеПоля(Поля, ОбъектМД);
	КонецЕсли;
	ДобавитьПоляКоллекции(Поля, ОбъектМД.Реквизиты);

	Возврат Поля;

КонецФункции

// Заполняет таблицу полей формы по метаданным таблицы запроса.
//
// Параметры:
//  ПолноеИмяТаблицы - Строка - полное имя таблицы запроса.
//  ТаблицаПолей - ДанныеФормыКоллекция - таблица с колонками ИмяПоля, Включить, ИмяВОтвете,
//    Формат, Реквизит.
//  СохранитьНастройкиПолей - Булево - сохранить строки, которые уже были в таблице: отметки, имена в ответе,
//    формат значения, повторы одного поля и поля, которых нет в метаданных (например, "Владелец.Наименование").
//
Процедура ЗаполнитьТаблицуПолейПоМетаданным(Знач ПолноеИмяТаблицы, ТаблицаПолей, Знач СохранитьНастройкиПолей) Экспорт

	СохраненныеСтроки = Новый Массив;
	Если СохранитьНастройкиПолей Тогда
		Для Каждого СтрокаПоля Из ТаблицаПолей Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаПоля.ИмяПоля)) Тогда
				Настройка = НастройкаСтрокиПоля(СокрЛП(СтрокаПоля.ИмяПоля), СтрокаПоля.Включить,
					СтрокаПоля.ИмяВОтвете, ФорматЗначенияСтроки(СтрокаПоля), СтрокаПоля.Реквизит);
				СохраненныеСтроки.Добавить(Настройка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЗаполнитьТаблицуПолей(ТаблицаПолей, ПолноеИмяТаблицы, СохраненныеСтроки, Истина);

КонецПроцедуры

// Проверяет таблицу полей мастера перед записью.
//
// Параметры:
//  ПоляКонструктора - ДанныеФормыКоллекция - таблица полей (ИмяПоля, Включить, ИмяВОтвете).
//
// Возвращаемое значение:
//  Строка - описание первой ошибки или пустая строка.
//
Функция ОшибкаПолейКонструктора(ПоляКонструктора) Экспорт

	ИменаВОтвете = Новый Соответствие;
	НомерСтроки = 0;
	Для Каждого СтрокаПоля Из ПоляКонструктора Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Не СтрокаПоля.Включить Тогда
			Продолжить;
		КонецЕсли;
		Поле = ПолеОтвета(СтрокаПоля.ИмяПоля, СтрокаПоля.ИмяВОтвете, ФорматЗначенияСтроки(СтрокаПоля),
			СтрокаПоля.Реквизит);
		ТекстОшибки = ОшибкаПоляОтвета(Поле);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат СтрШаблон("Поля ответа, строка %1: %2", НомерСтроки, ТекстОшибки);
		КонецЕсли;
		ИмяВОтвете = ИмяПоляВОтвете(Поле);
		Если ИменаВОтвете.Получить(ВРег(ИмяВОтвете)) <> Неопределено Тогда
			Возврат СтрШаблон("Поля ответа, строка %1: имя ""%2"" уже используется в ответе.", НомерСтроки, ИмяВОтвете);
		КонецЕсли;
		ИменаВОтвете.Вставить(ВРег(ИмяВОтвете), Истина);
	КонецЦикла;

	Возврат "";

КонецФункции

// Проверяет поле ответа: путь к полю и имя в ответе.
//
// Параметры:
//  Поле - Структура - см. ПоляКонструктораИзСтроки.
//
// Возвращаемое значение:
//  Строка - описание ошибки или пустая строка.
//
Функция ОшибкаПоляОтвета(Поле) Экспорт

	Если Не ЗначениеЗаполнено(Поле.Поле) Тогда
		Возврат "не указано поле.";
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Поле.Поле, ".") Цикл
		Если Не ЭтоИдентификатор(Часть) Тогда
			Возврат СтрШаблон("недопустимое имя поля ""%1"".", Поле.Поле);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Поле.ИмяВОтвете)
		И (Не ЭтоИдентификатор(Поле.ИмяВОтвете) Или ЭтоЗарезервированноеСлово(Поле.ИмяВОтвете)) Тогда
		Возврат СтрШаблон("недопустимое имя в ответе ""%1"": допустимы буквы, цифры и подчеркивание, "
			+ "первый символ - буква; нельзя использовать зарезервированные слова встроенного языка.", Поле.ИмяВОтвете);
	КонецЕсли;
	Если ЗначениеЗаполнено(Поле.ФорматЗначения)
		И ВариантыФорматаЗначенияПоля().НайтиПоЗначению(Поле.ФорматЗначения) = Неопределено Тогда
		Возврат СтрШаблон("неизвестный формат значения ""%1"".", Поле.ФорматЗначения);
	КонецЕсли;
	Если Поле.ФорматЗначения = ФорматЗначенияРеквизит() И Не ЭтоИдентификатор(Поле.Реквизит) Тогда
		Возврат СтрШаблон("для поля ""%1"" с форматом ""Реквизит"" не указан реквизит.", Поле.Поле);
	КонецЕсли;

	Возврат "";

КонецФункции

// Имя свойства в ответе: "Имя в ответе", а если оно не заполнено - имя поля без точек. Для формата "Код"
// к имени поля добавляется "Код", для формата "Реквизит" - имя реквизита: так одно поле можно вывести
// несколькими строками без ручного ввода имен.
//
// Параметры:
//  Поле - Структура - см. ПоляКонструктораИзСтроки.
//
// Возвращаемое значение:
//  Строка - имя свойства в ответе.
//
Функция ИмяПоляВОтвете(Поле) Экспорт

	Если ЗначениеЗаполнено(Поле.ИмяВОтвете) Тогда
		Возврат Поле.ИмяВОтвете;
	КонецЕсли;

	Имя = СтрЗаменить(Поле.Поле, ".", "");
	Если Поле.ФорматЗначения = ФорматЗначенияКод() Тогда
		Возврат Имя + "Код";
	ИначеЕсли Поле.ФорматЗначения = ФорматЗначенияРеквизит() Тогда
		Возврат Имя + Поле.Реквизит;
	Иначе
		Возврат Имя;
	КонецЕсли;

КонецФункции

// Варианты колонки "Формат" таблицы полей ответа.
//
// Возвращаемое значение:
//  СписокЗначений - значение - код формата, представление - описание. Пустой формат означает "Представление".
//
Функция ВариантыФорматаЗначенияПоля() Экспорт

	Варианты = Новый СписокЗначений;
	Варианты.Добавить(ФорматЗначенияПредставление(), "Представление");
	Варианты.Добавить(ФорматЗначенияИдентификатор(), "Идентификатор");
	Варианты.Добавить(ФорматЗначенияКод(), "Код");
	Варианты.Добавить(ФорматЗначенияРеквизит(), "Реквизит");
	Возврат Варианты;

КонецФункции

// Выражение поля в тексте запроса конструктора с учетом формата значения.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//  Поле - Структура - см. ПоляКонструктораИзСтроки.
//  ПсевдонимТаблицы - Строка - псевдоним таблицы в запросе.
//
// Возвращаемое значение:
//  Структура:
//   * Выражение - Строка - выражение поля, например "Т.Контрагент.ИНН".
//   * ФорматВывода - Строка - формат для ЗначениеПоляДляОтвета.
//
Функция ВыражениеПоляЗапроса(Знач ИмяТаблицы, Поле, Знач ПсевдонимТаблицы) Экспорт

	Результат = Новый Структура("Выражение, ФорматВывода", ПсевдонимТаблицы + "." + Поле.Поле, Поле.ФорматЗначения);

	Если Поле.ФорматЗначения = ФорматЗначенияРеквизит() Тогда
		Результат.Выражение = Результат.Выражение + "." + Поле.Реквизит;
		Результат.ФорматВывода = "";
	ИначеЕсли Поле.ФорматЗначения = ФорматЗначенияКод() Тогда
		ИмяКода = ИмяПоляКодаДляТипов(ОписаниеТиповПоляПоПути(ИмяТаблицы, Поле.Поле));
		Если ИмяКода = Неопределено Тогда
			// Перечисления выводятся именем значения, примитивные типы - как есть.
			Результат.ФорматВывода = ФорматЗначенияИдентификатор();
		Иначе
			Результат.Выражение = Результат.Выражение + "." + ИмяКода;
			Результат.ФорматВывода = "";
		КонецЕсли;
	Иначе
		// Представление и идентификатор получаются из самого значения поля при выводе.
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Реквизиты объектов, на которые ссылается поле, для выбора в колонке "Реквизит" таблицы полей ответа.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//  ИмяПоля - Строка - имя поля, допускается путь через точку.
//
// Возвращаемое значение:
//  СписокЗначений - значение - имя реквизита, представление - синоним. Пустой, если поле не ссылочное.
//
Функция РеквизитыДляФорматаПоля(Знач ИмяТаблицы, Знач ИмяПоля) Экспорт

	Результат = Новый СписокЗначений;
	Для Каждого ТипЗначения Из ОписаниеТиповПоляПоПути(ИмяТаблицы, ИмяПоля).Типы() Цикл
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
		Если Не ЭтоОбъектСПолямиКонструктора(ОбъектМД) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ПолеОбъекта Из ПоляТаблицыЗапроса(ОбъектМД.ПолноеИмя()) Цикл
			Если ПолеОбъекта.Имя <> "Ссылка" И Результат.НайтиПоЗначению(ПолеОбъекта.Имя) = Неопределено Тогда
				Результат.Добавить(ПолеОбъекта.Имя, ПолеОбъекта.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Варианты виртуальной таблицы для таблицы запроса. Срезы доступны только периодическим регистрам сведений.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//
// Возвращаемое значение:
//  СписокЗначений - значение - имя виртуальной таблицы (пустая строка - основная таблица), представление - описание.
//
Функция ВариантыВиртуальнойТаблицы(Знач ИмяТаблицы) Экспорт

	Варианты = Новый СписокЗначений;
	Варианты.Добавить("", "Основная таблица");
	ОбъектМД = ?(ЗначениеЗаполнено(ИмяТаблицы), Метаданные.НайтиПоПолномуИмени(ИмяТаблицы), Неопределено);
	Если ОбъектМД <> Неопределено И Метаданные.РегистрыСведений.Содержит(ОбъектМД)
		И ЭтоПериодическийРегистрСведений(ОбъектМД) Тогда
		Варианты.Добавить("СрезПоследних", "Срез последних");
		Варианты.Добавить("СрезПервых", "Срез первых");
	КонецЕсли;

	Возврат Варианты;

КонецФункции

// Виртуальная таблица настройки, если она допустима для таблицы запроса.
//
// Параметры:
//  ОбъектНастройки - СправочникОбъект.МС_НастройкиAPI, ДанныеФормыСтруктура, Структура - настройка API
//    с полем КонструкторВиртуальнаяТаблица.
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//
// Возвращаемое значение:
//  Строка - имя виртуальной таблицы или пустая строка (основная таблица).
//
Функция ВиртуальнаяТаблицаНастройки(ОбъектНастройки, Знач ИмяТаблицы) Экспорт

	ВиртуальнаяТаблица = СокрЛП(ОбъектНастройки.КонструкторВиртуальнаяТаблица);
	Если ВариантыВиртуальнойТаблицы(ИмяТаблицы).НайтиПоЗначению(ВиртуальнаяТаблица) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ВиртуальнаяТаблица;

КонецФункции

// Источник запроса конструктора: таблица или виртуальная таблица с параметром периода.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//  ВиртуальнаяТаблица - Строка - см. ВариантыВиртуальнойТаблицы.
//  ИмяПараметраПериода - Строка - имя параметра запроса, в котором передается период среза.
//
// Возвращаемое значение:
//  Строка - например, "РегистрСведений.КурсыВалют.СрезПоследних(&ПериодСреза, )".
//
Функция ИсточникЗапросаКонструктора(Знач ИмяТаблицы, Знач ВиртуальнаяТаблица, Знач ИмяПараметраПериода) Экспорт

	Если Не ЗначениеЗаполнено(ВиртуальнаяТаблица) Тогда
		Возврат ИмяТаблицы;
	КонецЕсли;

	Возврат СтрШаблон("%1.%2(&%3, )", ИмяТаблицы, ВиртуальнаяТаблица, ИмяПараметраПериода);

КонецФункции

// Проверяет настройку виртуальной таблицы перед записью.
//
// Параметры:
//  ОбъектНастройки - СправочникОбъект.МС_НастройкиAPI, ДанныеФормыСтруктура - настройка API.
//
// Возвращаемое значение:
//  Строка - описание ошибки или пустая строка.
//
Функция ОшибкаВиртуальнойТаблицы(ОбъектНастройки) Экспорт

	ИмяПараметра = СокрЛП(ОбъектНастройки.КонструкторПараметрПериода);
	Если ЗначениеЗаполнено(ВиртуальнаяТаблицаНастройки(ОбъектНастройки, ИмяТаблицыНастройки(ОбъектНастройки)))
		И ЗначениеЗаполнено(ИмяПараметра) И Не ЭтоИдентификатор(ИмяПараметра) Тогда
		Возврат СтрШаблон("Недопустимое имя параметра периода ""%1"": допустимы буквы, цифры и подчеркивание, "
			+ "первый символ - буква.", ИмяПараметра);
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение поля для ответа API с учетом формата значения.
//
// Параметры:
//  Значение - Произвольный - значение поля из результата запроса.
//  ФорматЗначения - Строка - см. ВариантыФорматаЗначенияПоля.
//
// Возвращаемое значение:
//  Произвольный - для формата "Идентификатор" и ссылочного значения - строка с УИД (для перечисления - имя
//    значения), для пустой ссылки - Неопределено; в остальных случаях - исходное значение.
//
Функция ЗначениеПоляДляОтвета(Значение, Знач ФорматЗначения) Экспорт

	Если ФорматЗначения <> ФорматЗначенияИдентификатор()
		Или Метаданные.НайтиПоТипу(ТипЗнч(Значение)) = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат XMLСтрока(Значение);

КонецФункции

// Заполняет список выбора колонки "Поле" в отборах конструктора.
//
// Параметры:
//  ПолноеИмяТаблицы - Строка - полное имя таблицы запроса.
//  СписокВыбора - СписокЗначений - список выбора элемента формы.
//  ДополнительныеИмена - Массив из Строка - уже введенные поля, которых нет в метаданных (старые настройки).
//
Процедура ЗаполнитьСписокВыбораПолейОтбора(Знач ПолноеИмяТаблицы, СписокВыбора, Знач ДополнительныеИмена) Экспорт

	СписокВыбора.Очистить();
	Для Каждого Поле Из ПоляТаблицыЗапроса(ПолноеИмяТаблицы) Цикл
		СписокВыбора.Добавить(Поле.Имя, Поле.Представление);
	КонецЦикла;

	Для Каждого Имя Из ДополнительныеИмена Цикл
		ИмяПоля = СокрЛП(Имя);
		Если ЗначениеЗаполнено(ИмяПоля) И СписокВыбора.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
			СписокВыбора.Добавить(ИмяПоля, ИмяПоля);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Загружает таблицы мастера конструктора на форме из реквизитов настройки.
// Для старых настроек, где задано только КонструкторИмяТаблицы, восстанавливает поля мастера.
//
// Параметры:
//  ОбъектНастройки - ДанныеФормыСтруктура - реквизит формы "Объект".
//  ПоляКонструктора - ДанныеФормыКоллекция - таблица полей (ИмяПоля, Включить, ИмяВОтвете, Формат, Реквизит).
//  ОтборыКонструктора - ДанныеФормыКоллекция - таблица отборов
//    (Поле, Сравнение, ИмяПараметра, ЗначениеКонстанты, ЗначениеВнутр).
//
Процедура ЗагрузитьКонструкторВТаблицыФормы(ОбъектНастройки, ПоляКонструктора, ОтборыКонструктора) Экспорт

	ВосстановитьМастерПоИмениТаблицы(ОбъектНастройки);
	ИмяТаблицы = ИмяТаблицыНастройки(ОбъектНастройки);

	ЗагрузитьПоляКонструктора(ОбъектНастройки.КонструкторПоля, ИмяТаблицы, ПоляКонструктора);

	ОтборыКонструктора.Очистить();
	Попытка
		Отборы = ОтборыКонструктораИзJSON(ОбъектНастройки.КонструкторОтборыJSON);
		ЗагрузитьОтборыКонструктора(Отборы, ИмяТаблицы, ОтборыКонструктора);
	Исключение
		ТекстОшибки = "Не удалось прочитать отборы конструктора: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Записывает в настройку имя таблицы, поля и отборы из таблиц мастера конструктора.
//
// Параметры:
//  ОбъектНастройки - СправочникОбъект.МС_НастройкиAPI - записываемая настройка.
//  ПоляКонструктора - ДанныеФормыКоллекция - таблица полей мастера.
//  ОтборыКонструктора - ДанныеФормыКоллекция - таблица отборов мастера.
//
Процедура ПрименитьМастерКонструкторуКОбъекту(ОбъектНастройки, ПоляКонструктора, ОтборыКонструктора) Экспорт

	ИмяТаблицы = ИмяТаблицыНастройки(ОбъектНастройки);
	ОбъектНастройки.КонструкторИмяТаблицы = ИмяТаблицы;
	ОбъектНастройки.КонструкторВиртуальнаяТаблица = ВиртуальнаяТаблицаНастройки(ОбъектНастройки, ИмяТаблицы);
	Если Не ЗначениеЗаполнено(ОбъектНастройки.КонструкторВиртуальнаяТаблица) Тогда
		ОбъектНастройки.КонструкторПараметрПериода = "";
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого СтрокаПоля Из ПоляКонструктора Цикл
		Если СтрокаПоля.Включить И ЗначениеЗаполнено(СтрокаПоля.ИмяПоля) Тогда
			Поля.Добавить(ПолеОтвета(СтрокаПоля.ИмяПоля, СтрокаПоля.ИмяВОтвете, ФорматЗначенияСтроки(СтрокаПоля),
				СтрокаПоля.Реквизит));
		КонецЕсли;
	КонецЦикла;
	ОбъектНастройки.КонструкторПоля = ЗначениеВJSON(Поля);

	Отборы = Новый Массив;
	Для Каждого СтрокаОтбора Из ОтборыКонструктора Цикл
		Отбор = ОтборДляСохранения(СтрокаОтбора, ИмяТаблицы);
		Если Отбор <> Неопределено Тогда
			Отборы.Добавить(Отбор);
		КонецЕсли;
	КонецЦикла;
	ОбъектНастройки.КонструкторОтборыJSON = ЗначениеВJSON(Отборы);

КонецПроцедуры

// Разбирает сохраненный список полей конструктора. Поддерживаются форматы:
// массив объектов {"Поле": ..., "ИмяВОтвете": ...}, массив имен полей и имена через запятую.
//
// Параметры:
//  СтрокаПолей - Строка - значение реквизита КонструкторПоля.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Поле - Строка - имя поля таблицы, допускается путь через точку;
//   * ИмяВОтвете - Строка - имя свойства в ответе API, пустая строка - имя поля;
//   * ФорматЗначения - Строка - см. ВариантыФорматаЗначенияПоля, пустая строка - представление;
//   * Реквизит - Строка - реквизит ссылки для формата "Реквизит".
//
Функция ПоляКонструктораИзСтроки(Знач СтрокаПолей) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СтрокаПолей) Тогда
		Возврат Результат;
	КонецЕсли;

	Прочитанное = Неопределено;
	Если СтрНачинаетсяС(СокрЛ(СтрокаПолей), "[") Тогда
		Попытка
			Прочитанное = JSONВЗначение(СтрокаПолей, Истина);
		Исключение
			Прочитанное = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Прочитанное) <> Тип("Массив") Тогда
		Прочитанное = СтрРазделить(СтрокаПолей, ",", Ложь);
	КонецЕсли;

	Для Каждого Элемент Из Прочитанное Цикл
		Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Поле = ПолеОтвета(СтрокаСвойства(Элемент, "Поле"), СтрокаСвойства(Элемент, "ИмяВОтвете"),
				СтрокаСвойства(Элемент, "ФорматЗначения"), СтрокаСвойства(Элемент, "Реквизит"));
		Иначе
			Поле = ПолеОтвета(Строка(Элемент), "", "", "");
		КонецЕсли;
		Если ЗначениеЗаполнено(Поле.Поле) Тогда
			Результат.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разбирает сохраненные отборы конструктора.
//
// Параметры:
//  СтрокаJSON - Строка - значение реквизита КонструкторОтборыJSON.
//
// Возвращаемое значение:
//  Массив из Структура - отборы с заполненным полем:
//   * Поле - Строка - имя поля таблицы;
//   * Сравнение - Строка - вид сравнения ("=" по умолчанию);
//   * ИмяПараметра - Строка - имя параметра API, если значение передается в вызове;
//   * ЗначениеВнутр - Строка - фиксированное значение, сериализованное ЗначениеВСтрокуВнутр;
//   * Значение - Произвольный - фиксированное значение в старом формате (строка или примитив).
//
Функция ОтборыКонструктораИзJSON(Знач СтрокаJSON) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Прочитанное = JSONВЗначение(СтрокаJSON, Истина);
	Если ТипЗнч(Прочитанное) <> Тип("Массив") Тогда
		ВызватьИсключение "Отборы конструктора должны быть массивом JSON.";
	КонецЕсли;

	Для Каждого Элемент Из Прочитанное Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("Поле", СтрокаСвойства(Элемент, "Поле"));
		Отбор.Вставить("Сравнение", СтрокаСвойства(Элемент, "Сравнение"));
		Отбор.Вставить("ИмяПараметра", СтрокаСвойства(Элемент, "ИмяПараметра"));
		Отбор.Вставить("ЗначениеВнутр", СтрокаСвойства(Элемент, "ЗначениеВнутр"));
		Отбор.Вставить("Значение", ЗначениеСвойства(Элемент, "Значение"));
		Если Не ЗначениеЗаполнено(Отбор.Поле) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отбор.Сравнение) Тогда
			Отбор.Сравнение = "=";
		КонецЕсли;
		Результат.Добавить(Отбор);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, задано ли у отбора фиксированное значение.
//
// Параметры:
//  Отбор - Структура - см. ОтборыКонструктораИзJSON.
//
// Возвращаемое значение:
//  Булево - Истина, если значение задано.
//
Функция ЕстьФиксированноеЗначениеОтбора(Отбор) Экспорт

	Возврат ЗначениеЗаполнено(Отбор.ЗначениеВнутр) Или Отбор.Значение <> Неопределено;

КонецФункции

// Имя параметра API, от которого зависит отбор. Строка с фиксированным значением от параметра не зависит:
// фиксированное значение важнее параметра, и клиент API не может его заменить.
//
// Параметры:
//  Отбор - Структура, ДанныеФормыЭлементКоллекции - отбор из КонструкторОтборыJSON (см. ОтборыКонструктораИзJSON)
//    или строка таблицы отборов формы.
//
// Возвращаемое значение:
//  Строка - имя параметра или пустая строка.
//
Функция ИмяПараметраОтбора(Отбор) Экспорт

	Данные = Новый Структура("ИмяПараметра, ЗначениеВнутр, ЗначениеКонстанты, Значение");
	ЗаполнитьЗначенияСвойств(Данные, Отбор);
	Если ЗначениеЗаполнено(Данные.ЗначениеВнутр) Или ЗначениеЗаполнено(Данные.ЗначениеКонстанты)
		Или Данные.Значение <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Данные.ИмяПараметра);

КонецФункции

// Фиксированное значение отбора, приведенное к типу поля.
//
// Параметры:
//  Отбор - Структура - см. ОтборыКонструктораИзJSON.
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//
// Возвращаемое значение:
//  Произвольный - значение отбора.
//
Функция ЗначениеФиксированногоОтбора(Отбор, Знач ИмяТаблицы) Экспорт

	Если ЗначениеЗаполнено(Отбор.ЗначениеВнутр) Тогда
		Возврат ЗначениеИзСтрокиВнутр(Отбор.ЗначениеВнутр);
	КонецЕсли;

	Если ТипЗнч(Отбор.Значение) = Тип("Строка") Тогда
		ОписаниеТипов = ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, Отбор.Поле);
		Возврат ЗначениеИзСтрокиПоОписаниюТипов(ОписаниеТипов, Отбор.Значение);
	КонецЕсли;

	Возврат Отбор.Значение;

КонецФункции

// Представление и сериализованное значение фиксированного отбора для строки таблицы отборов на форме.
//
// Параметры:
//  Значение - Произвольный - значение, выбранное пользователем.
//
// Возвращаемое значение:
//  Структура:
//   * Представление - Строка - текст для колонки "Значение (фикс.)";
//   * ЗначениеВнутр - Строка - значение, сериализованное ЗначениеВСтрокуВнутр.
//
Функция ДанныеФиксированногоЗначенияОтбора(Знач Значение) Экспорт

	Возврат Новый Структура("Представление, ЗначениеВнутр",
		ПредставлениеЗначенияОтбора(Значение), ЗначениеВСтрокуВнутр(Значение));

КонецФункции

// Описание типов поля таблицы запроса.
//
// Параметры:
//  ПолноеИмяТаблицы - Строка - полное имя таблицы запроса.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  ОписаниеТипов - тип поля; пустое описание, если поле не найдено.
//
Функция ПолучитьОписаниеТипаПоляТаблицы(Знач ПолноеИмяТаблицы, Знач ИмяПоля) Экспорт

	ИмяПоляВРег = ВРег(СокрЛП(ИмяПоля));
	Если ЗначениеЗаполнено(ИмяПоляВРег) Тогда
		Для Каждого Поле Из ПоляТаблицыЗапроса(ПолноеИмяТаблицы) Цикл
			Если ВРег(Поле.Имя) = ИмяПоляВРег Тогда
				Возврат Поле.Тип;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый ОписаниеТипов;

КонецФункции

// Краткое имя типа для колонки "Тип" в параметрах API.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов, Неопределено - тип поля отбора.
//
// Возвращаемое значение:
//  Строка - СТРОКА, ЧИСЛО, БУЛЕВО, ДАТА, УИД, ССЫЛКА, ПЕРЕЧИСЛЕНИЕ или пустая строка.
//
Функция КраткоеИмяТипаПараметраAPI(Знач ОписаниеТипов) Экспорт

	Если ОписаниеТипов = Неопределено Или ОписаниеТипов.Типы().Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПервыйТип = ОписаниеТипов.Типы()[0];
	ИменаПримитивныхТипов = Новый Соответствие;
	ИменаПримитивныхТипов.Вставить(Тип("Строка"), "СТРОКА");
	ИменаПримитивныхТипов.Вставить(Тип("Число"), "ЧИСЛО");
	ИменаПримитивныхТипов.Вставить(Тип("Булево"), "БУЛЕВО");
	ИменаПримитивныхТипов.Вставить(Тип("Дата"), "ДАТА");
	ИменаПримитивныхТипов.Вставить(Тип("УникальныйИдентификатор"), "УИД");
	ИмяТипа = ИменаПримитивныхТипов.Получить(ПервыйТип);
	Если ИмяТипа <> Неопределено Тогда
		Возврат ИмяТипа;
	КонецЕсли;

	Если ЭтоТипПеречисления(ПервыйТип) Тогда
		Возврат "ПЕРЕЧИСЛЕНИЕ";
	ИначеЕсли Метаданные.НайтиПоТипу(ПервыйТип) <> Неопределено Тогда
		Возврат "ССЫЛКА";
	Иначе
		Возврат "СТРОКА";
	КонецЕсли;

КонецФункции

// Способ сопоставления строки с полем отбора по умолчанию: для перечислений - по имени, иначе автоматически.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов, Неопределено - тип поля отбора.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.МС_СпособСопоставленияПараметраОтбора - способ сопоставления.
//
Функция СпособСопоставленияПараметраОтбораПоУмолчанию(Знач ОписаниеТипов) Экспорт

	Если ОписаниеТипов <> Неопределено
		И ОписаниеТипов.Типы().Количество() > 0
		И ЭтоТипПеречисления(ОписаниеТипов.Типы()[0]) Тогда
		Возврат Перечисления.МС_СпособСопоставленияПараметраОтбора.Наименование;
	КонецЕсли;

	Возврат Перечисления.МС_СпособСопоставленияПараметраОтбора.Авто;

КонецФункции

// Преобразует строку к типу поля по описанию типов (ссылки ищутся автоматически).
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов, Неопределено - тип поля.
//  ЗначениеСтрока - Строка - исходное значение.
//
// Возвращаемое значение:
//  Произвольный - значение типа поля.
//
Функция ЗначениеИзСтрокиПоОписаниюТипов(Знач ОписаниеТипов, Знач ЗначениеСтрока) Экспорт

	Возврат ЗначениеИзСтрокиПоОписаниюТиповИСпособу(ОписаниеТипов, ЗначениеСтрока, Неопределено);

КонецФункции

// Преобразует строку к типу поля; для ссылок учитывает способ сопоставления (УИД, код, наименование).
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов, Неопределено - тип поля.
//  ЗначениеСтрока - Строка, Неопределено - исходное значение.
//  СпособСопоставления - ПеречислениеСсылка.МС_СпособСопоставленияПараметраОтбора, Неопределено - способ поиска ссылки.
//
// Возвращаемое значение:
//  Произвольный - значение типа поля; Неопределено, если исходное значение не задано или ссылка не найдена.
//
Функция ЗначениеИзСтрокиПоОписаниюТиповИСпособу(Знач ОписаниеТипов, Знач ЗначениеСтрока,
	Знач СпособСопоставления) Экспорт

	Если ЗначениеСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Стр = СокрЛП(Строка(ЗначениеСтрока));
	Если ОписаниеТипов = Неопределено Или ОписаниеТипов.Типы().Количество() = 0 Тогда
		Возврат Стр;
	ИначеЕсли ОписаниеТипов.Типы().Количество() = 1 Тогда
		Возврат ЗначениеИзСтрокиДляТипа(ОписаниеТипов.Типы()[0], Стр, СпособСопоставления);
	Иначе
		Возврат ЗначениеИзСтрокиДляСоставногоТипа(ОписаниеТипов, Стр);
	КонецЕсли;

КонецФункции

// Приводит значение параметра API (строка запроса или JSON) к типу поля отбора.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы запроса.
//  ИмяПоля - Строка - имя поля отбора.
//  СыроеЗначение - Произвольный - значение из вызова API.
//  ТипПараметраСтрока - Строка - тип из колонки "Тип" параметров API, если тип поля не определен.
//  СпособСопоставления - ПеречислениеСсылка.МС_СпособСопоставленияПараметраОтбора, Неопределено - способ поиска ссылки.
//
// Возвращаемое значение:
//  Произвольный - значение для отбора.
//
Функция ПривестиСыроеЗначениеПараметраОтбораКТипуПоля(Знач ИмяТаблицы, Знач ИмяПоля, Знач СыроеЗначение,
	Знач ТипПараметраСтрока, Знач СпособСопоставления = Неопределено) Экспорт

	Если ТипЗнч(СыроеЗначение) <> Тип("Строка") Тогда
		Возврат СыроеЗначение;
	КонецЕсли;

	ОписаниеТипов = ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, ИмяПоля);
	Если ОписаниеТипов.Типы().Количество() > 0 Тогда
		Возврат ЗначениеИзСтрокиПоОписаниюТиповИСпособу(ОписаниеТипов, СыроеЗначение, СпособСопоставления);
	КонецЕсли;

	Возврат ЗначениеПараметраПоТипу(СыроеЗначение, ТипПараметраСтрока);

КонецФункции

// Приводит строковое значение параметра API к типу из колонки "Тип" параметров API.
// Значения других типов (например, числа из JSON) возвращаются без изменений.
//
// Параметры:
//  Значение - Произвольный - значение параметра.
//  ТипПараметра - Строка - ЧИСЛО, БУЛЕВО, ДАТА, УИД; для прочих значение не меняется.
//
// Возвращаемое значение:
//  Произвольный - приведенное значение.
//
Функция ЗначениеПараметраПоТипу(Знач Значение, Знач ТипПараметра) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	ТипПараметраВРег = ВРег(СокрЛП(ТипПараметра));
	Если ТипПараметраВРег = "ЧИСЛО" Или ТипПараметраВРег = "NUMBER" Тогда
		Возврат ЧислоИзСтроки(Значение);
	ИначеЕсли ТипПараметраВРег = "БУЛЕВО" Или ТипПараметраВРег = "BOOLEAN" Тогда
		Возврат БулевоИзСтроки(Значение) = Истина;
	ИначеЕсли ТипПараметраВРег = "ДАТА" Или ТипПараметраВРег = "DATE" Тогда
		Возврат ДатаИзСтроки(Значение);
	ИначеЕсли ТипПараметраВРег = "УИД" Или ТипПараметраВРег = "UUID" Тогда
		Возврат УникальныйИдентификаторИзСтроки(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МетаданныеИсточника

Функция ВидыОбъектовМетаданныхПоТипуИсточника()

	ТипыИсточника = Перечисления.МС_ТипИсточникаКонструктораAPI;
	Результат = Новый Соответствие;
	Результат.Вставить(ТипыИсточника.Справочник, "Справочник");
	Результат.Вставить(ТипыИсточника.Документ, "Документ");
	Результат.Вставить(ТипыИсточника.РегистрСведений, "РегистрСведений");
	Результат.Вставить(ТипыИсточника.ПланВидовХарактеристик, "ПланВидовХарактеристик");
	Возврат Результат;

КонецФункции

Функция КоллекцияМетаданныхПоТипуИсточника(ТипИсточника)

	ТипыИсточника = Перечисления.МС_ТипИсточникаКонструктораAPI;
	Если ТипИсточника = ТипыИсточника.Справочник Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли ТипИсточника = ТипыИсточника.Документ Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли ТипИсточника = ТипыИсточника.РегистрСведений Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли ТипИсточника = ТипыИсточника.ПланВидовХарактеристик Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	Иначе
		Возврат Новый Массив;
	КонецЕсли;

КонецФункции

Функция ТипИсточникаСТабличнымиЧастями(ТипИсточника)

	Возврат ТипИсточника = Перечисления.МС_ТипИсточникаКонструктораAPI.Справочник
		Или ТипИсточника = Перечисления.МС_ТипИсточникаКонструктораAPI.Документ;

КонецФункции

Функция ИмяКоллекцииТабличныхЧастей()

	Возврат "ТабличнаяЧасть";

КонецФункции

Функция ЭтоИмяТабличнойЧасти(Части)
	
	// Части полного имени вида "Документ.Заказ.ТабличнаяЧасть.Товары".

	Возврат Части.Количество() = 4 И ВРег(СокрЛП(Части[2])) = ВРег(ИмяКоллекцииТабличныхЧастей());

КонецФункции

Процедура ВосстановитьМастерПоИмениТаблицы(ОбъектНастройки)
	
	// Для старых настроек, где сохранено только полное имя таблицы, заполняет поля мастера.

	Если ЗначениеЗаполнено(ОбъектНастройки.КонструкторИмяОбъекта)
		Или Не ЗначениеЗаполнено(ОбъектНастройки.КонструкторИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;

	Части = СтрРазделить(ОбъектНастройки.КонструкторИмяТаблицы, ".");
	Если Части.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = ВРег(СокрЛП(Части[0]));
	Для Каждого КлючИЗначение Из ВидыОбъектовМетаданныхПоТипуИсточника() Цикл
		Если ВРег(КлючИЗначение.Значение) <> ВидОбъекта Тогда
			Продолжить;
		КонецЕсли;
		ОбъектНастройки.КонструкторТипИсточника = КлючИЗначение.Ключ;
		ОбъектНастройки.КонструкторИмяОбъекта = СокрЛП(Части[1]);
		Если ЭтоИмяТабличнойЧасти(Части) И ТипИсточникаСТабличнымиЧастями(КлючИЗначение.Ключ) Тогда
			ОбъектНастройки.КонструкторИмяТабличнойЧасти = СокрЛП(Части[3]);
		КонецЕсли;
		Прервать;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляТабличнойЧасти(Поля, Части)

	Владелец = Метаданные.НайтиПоПолномуИмени(СокрЛП(Части[0]) + "." + СокрЛП(Части[1]));
	Если Владелец = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТабличнаяЧасть = Владелец.ТабличныеЧасти.Найти(СокрЛП(Части[3]));
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьПоле(Поля, "Ссылка", "Ссылка", ОписаниеТипаСсылки(Владелец.ПолноеИмя()));
	ДобавитьПоле(Поля, "НомерСтроки", "Номер строки", Новый ОписаниеТипов("Число"));
	ДобавитьПоляКоллекции(Поля, ТабличнаяЧасть.Реквизиты);

КонецПроцедуры

Процедура ДобавитьСтандартныеПоля(Поля, ОбъектМД)

	// Стандартные реквизиты, которые есть у объекта при любых свойствах метаданных.
	ДобавитьПоле(Поля, "ПометкаУдаления", "Пометка удаления", Новый ОписаниеТипов("Булево"));
	Если Метаданные.Документы.Содержит(ОбъектМД) Тогда
		ДобавитьПоле(Поля, "Дата", "Дата", Новый ОписаниеТипов("Дата"));
		Если ОбъектМД.ДлинаНомера > 0 Тогда
			ЧисловойНомер = ОбъектМД.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Число;
			ДобавитьПоле(Поля, "Номер", "Номер", Новый ОписаниеТипов(?(ЧисловойНомер, "Число", "Строка")));
		КонецЕсли;
		ДобавитьПоле(Поля, "Проведен", "Проведен", Новый ОписаниеТипов("Булево"));
		Возврат;
	КонецЕсли;

	Если ОбъектМД.ДлинаКода > 0 Тогда
		ДобавитьПоле(Поля, "Код", "Код", Новый ОписаниеТипов(?(ЭтоЧисловойКодСправочника(ОбъектМД), "Число", "Строка")));
	КонецЕсли;
	Если ОбъектМД.ДлинаНаименования > 0 Тогда
		ДобавитьПоле(Поля, "Наименование", "Наименование", Новый ОписаниеТипов("Строка"));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоляКоллекции(Поля, КоллекцияМД)

	Для Каждого ЭлементМД Из КоллекцияМД Цикл
		ДобавитьПоле(Поля, ЭлементМД.Имя, ЭлементМД.Представление(), ЭлементМД.Тип);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоле(Поля, Имя, Представление, ОписаниеТипов)

	Поля.Добавить(Новый Структура("Имя, Представление, Тип", Имя, Представление, ОписаниеТипов));

КонецПроцедуры

Функция ОписаниеТипаСсылки(ПолноеИмяОбъекта)
	
	// "Справочник.Валюты" -> ОписаниеТипов("СправочникСсылка.Валюты").

	Части = СтрРазделить(ПолноеИмяОбъекта, ".");
	Возврат Новый ОписаниеТипов(Части[0] + "Ссылка." + Части[1]);

КонецФункции

Функция ЭтоТипПеречисления(ПроверяемыйТип)

	ОбъектМД = Метаданные.НайтиПоТипу(ПроверяемыйТип);
	Возврат ОбъектМД <> Неопределено И Метаданные.Перечисления.Содержит(ОбъектМД);

КонецФункции

Функция ЭтоПериодическийРегистрСведений(ОбъектМД)

	Возврат ОбъектМД.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;

КонецФункции

Функция ОписаниеТиповПоляПоПути(ИмяТаблицы, Путь)

	// Тип поля с путем через точку, например "Контрагент.ГоловнойКонтрагент": первое поле ищется в таблице
	// запроса, следующие - в объектах, на которые ссылается предыдущее. Пустое описание, если путь не разобрать.

	Части = СтрРазделить(СокрЛП(Путь), ".");
	ОписаниеТипов = ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, Части[0]);
	Для Индекс = 1 По Части.ВГраница() Цикл
		Типы = Новый Массив;
		Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
			ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
			Если Не ЭтоОбъектСПолямиКонструктора(ОбъектМД) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТипПоля Из ПолучитьОписаниеТипаПоляТаблицы(ОбъектМД.ПолноеИмя(), Части[Индекс]).Типы() Цикл
				Типы.Добавить(ТипПоля);
			КонецЦикла;
		КонецЦикла;
		ОписаниеТипов = Новый ОписаниеТипов(Типы);
	КонецЦикла;

	Возврат ОписаниеТипов;

КонецФункции

Функция ЭтоОбъектСПолямиКонструктора(ОбъектМД)

	// Объекты, поля которых конструктор умеет перечислять: справочники, документы, планы видов характеристик.
	Возврат ОбъектМД <> Неопределено
		И (Метаданные.Справочники.Содержит(ОбъектМД)
			Или Метаданные.Документы.Содержит(ОбъектМД)
			Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМД));

КонецФункции

Функция ИмяПоляКодаДляТипов(ОписаниеТипов)

	// "Код" для справочников и планов, "Номер" для документов, бизнес-процессов и задач.
	// Неопределено - у типов нет кода (перечисления, примитивные типы). Если тип не определен, - "Код".

	Если ОписаниеТипов.Типы().Количество() = 0 Тогда
		Возврат "Код";
	КонецЕсли;

	ЕстьКод = Ложь;
	ЕстьНомер = Ложь;
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМД = Неопределено Тогда
			Продолжить;
		ИначеЕсли ЭтоОбъектСНомером(ОбъектМД) Тогда
			ЕстьНомер = ЕстьНомер Или ОбъектМД.ДлинаНомера > 0;
		ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМД)
			Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМД)
			Или Метаданные.ПланыСчетов.Содержит(ОбъектМД)
			Или Метаданные.ПланыВидовРасчета.Содержит(ОбъектМД) Тогда
			ЕстьКод = ЕстьКод Или ОбъектМД.ДлинаКода > 0;
		Иначе
			// Перечисления и прочие объекты кода не имеют.
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьКод Тогда
		Возврат "Код";
	ИначеЕсли ЕстьНомер Тогда
		Возврат "Номер";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ОтсортированныйПоПредставлению(Массив)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("Представление");
	Для Каждого Элемент Из Массив Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Элемент);
	КонецЦикла;
	Таблица.Сортировать("Представление");

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(Новый Структура("Имя, Представление", СтрокаТаблицы.Имя, СтрокаТаблицы.Представление));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ТаблицыМастера

Процедура ЗагрузитьПоляКонструктора(СтрокаПолей, ИмяТаблицы, ПоляКонструктора)

	// Показывает все поля таблицы; отмечены сохраненные. Сохраненные поля, которых нет в метаданных, добавляются в конец.
	СохраненныеСтроки = Новый Массив;
	Для Каждого Поле Из ПоляКонструктораИзСтроки(СтрокаПолей) Цикл
		СохраненныеСтроки.Добавить(НастройкаСтрокиПоля(Поле.Поле, Истина, Поле.ИмяВОтвете, Поле.ФорматЗначения,
			Поле.Реквизит));
	КонецЦикла;

	// Новая настройка без сохраненных полей - отмечены все поля таблицы.
	ЗаполнитьТаблицуПолей(ПоляКонструктора, ИмяТаблицы, СохраненныеСтроки, СохраненныеСтроки.Количество() = 0);

КонецПроцедуры

Процедура ЗаполнитьТаблицуПолей(ТаблицаПолей, ИмяТаблицы, СохраненныеСтроки, ОтмечатьНовые)

	// Поля таблицы в порядке метаданных. Для поля с сохраненными строками выводятся все его строки
	// (одно поле может выводиться в ответ несколько раз, например представлением и идентификатором),
	// для остальных - строка с отметкой ОтмечатьНовые. Сохраненные поля, которых нет в метаданных, - в конце.
	СтрокиПоПолю = Новый Соответствие;
	Для Каждого Настройка Из СохраненныеСтроки Цикл
		Ключ = ВРег(Настройка.ИмяПоля);
		Если СтрокиПоПолю.Получить(Ключ) = Неопределено Тогда
			СтрокиПоПолю.Вставить(Ключ, Новый Массив);
		КонецЕсли;
		СтрокиПоПолю.Получить(Ключ).Добавить(Настройка);
	КонецЦикла;

	ТаблицаПолей.Очистить();
	Выведенные = Новый Соответствие;
	Для Каждого Поле Из ПоляТаблицыЗапроса(ИмяТаблицы) Цикл
		Ключ = ВРег(Поле.Имя);
		Выведенные.Вставить(Ключ, Истина);
		СтрокиПоля = СтрокиПоПолю.Получить(Ключ);
		Если СтрокиПоля = Неопределено Тогда
			ДобавитьСтрокуПоля(ТаблицаПолей, НастройкаСтрокиПоля(Поле.Имя, ОтмечатьНовые, "", "", ""));
			Продолжить;
		КонецЕсли;
		Для Каждого Настройка Из СтрокиПоля Цикл
			ДобавитьСтрокуПоля(ТаблицаПолей, Настройка);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Настройка Из СохраненныеСтроки Цикл
		Если Выведенные.Получить(ВРег(Настройка.ИмяПоля)) = Неопределено Тогда
			ДобавитьСтрокуПоля(ТаблицаПолей, Настройка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуПоля(ТаблицаПолей, Настройка)

	НоваяСтрока = ТаблицаПолей.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Настройка, "ИмяПоля, Включить, ИмяВОтвете, Реквизит");
	НоваяСтрока.Формат = ?(ЗначениеЗаполнено(Настройка.ФорматЗначения), Настройка.ФорматЗначения,
		ФорматЗначенияПредставление());

КонецПроцедуры

Функция НастройкаСтрокиПоля(ИмяПоля, Включить, ИмяВОтвете, ФорматЗначения, Реквизит)

	Настройка = Новый Структура;
	Настройка.Вставить("ИмяПоля", ИмяПоля);
	Настройка.Вставить("Включить", Включить);
	Настройка.Вставить("ИмяВОтвете", СокрЛП(ИмяВОтвете));
	Настройка.Вставить("ФорматЗначения", СокрЛП(ФорматЗначения));
	Настройка.Вставить("Реквизит", СокрЛП(Реквизит));
	Возврат Настройка;

КонецФункции

Функция ПолеОтвета(ИмяПоля, ИмяВОтвете, ФорматЗначения, Реквизит)

	// Реквизит хранится только для формата "Реквизит".
	Формат = СокрЛП(ФорматЗначения);
	Возврат Новый Структура("Поле, ИмяВОтвете, ФорматЗначения, Реквизит",
		СокрЛП(ИмяПоля), СокрЛП(ИмяВОтвете), Формат, ?(Формат = ФорматЗначенияРеквизит(), СокрЛП(Реквизит), ""));

