Функция ФорматЗначенияСтроки(СтрокаПоля)

	// "Представление" - формат по умолчанию, в настройке хранится пустой строкой.
	Формат = СокрЛП(СтрокаПоля.Формат);
	Возврат ?(Формат = ФорматЗначенияПредставление(), "", Формат);

