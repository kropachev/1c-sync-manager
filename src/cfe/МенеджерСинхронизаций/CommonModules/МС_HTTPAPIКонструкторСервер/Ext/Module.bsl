Процедура ЗагрузитьОтборыКонструктора(Отборы, ИмяТаблицы, ОтборыКонструктора)

	Для Каждого Отбор Из Отборы Цикл
		НоваяСтрока = ОтборыКонструктора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор, "Поле, Сравнение, ИмяПараметра");
		Если Не ЕстьФиксированноеЗначениеОтбора(Отбор) Тогда
			Продолжить;
		КонецЕсли;
		ДанныеЗначения = ДанныеФиксированногоЗначенияОтбора(ЗначениеФиксированногоОтбора(Отбор, ИмяТаблицы));
		НоваяСтрока.ЗначениеКонстанты = ДанныеЗначения.Представление;
		НоваяСтрока.ЗначениеВнутр = ДанныеЗначения.ЗначениеВнутр;
	КонецЦикла;

КонецПроцедуры

Функция ОтборДляСохранения(СтрокаОтбора, ИмяТаблицы)
	
	// Отбор для записи в КонструкторОтборыJSON или Неопределено, если строка не задает отбор.

	Поле = СокрЛП(СтрокаОтбора.Поле);
	Если Не ЗначениеЗаполнено(Поле) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отбор = Новый Структура;
	Отбор.Вставить("Поле", Поле);
	Отбор.Вставить("Сравнение", ?(ЗначениеЗаполнено(СтрокаОтбора.Сравнение), СокрЛП(СтрокаОтбора.Сравнение), "="));

	// Фиксированное значение важнее параметра: параметр в такой строке не сохраняется,
	// и клиент API не может заменить значение отбора своим.
	ЗначениеСтрокой = СокрЛП(СтрокаОтбора.ЗначениеКонстанты);
	Если ЗначениеЗаполнено(СтрокаОтбора.ЗначениеВнутр) Тогда
		Отбор.Вставить("ЗначениеВнутр", СтрокаОтбора.ЗначениеВнутр);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеСтрокой) Тогда
		// Значение введено в ячейке вручную - приводим к типу поля.
		ОписаниеТипов = ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, Поле);
		Значение = ЗначениеИзСтрокиПоОписаниюТипов(ОписаниеТипов, ЗначениеСтрокой);
		Отбор.Вставить("ЗначениеВнутр", ЗначениеВСтрокуВнутр(Значение));
	ИначеЕсли ЗначениеЗаполнено(СтрокаОтбора.ИмяПараметра) Тогда
		Отбор.Вставить("ИмяПараметра", СокрЛП(СтрокаОтбора.ИмяПараметра));
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Возврат Отбор;

КонецФункции

Функция ПредставлениеЗначенияОтбора(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли ТипЗначения = Тип("Дата") Или ТипЗначения = Тип("Число") Тогда
		Возврат XMLСтрока(Значение);
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ПреобразованиеСтрок

Функция ЗначениеИзСтрокиДляТипа(ТипЗначения, Стр, СпособСопоставления)

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Стр;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ЧислоИзСтроки(Стр);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат БулевоИзСтроки(Стр) = Истина;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ДатаИзСтроки(Стр);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат УникальныйИдентификаторИзСтроки(Стр);
	Иначе
		Возврат СсылкаИзСтроки(ТипЗначения, Стр, СпособСопоставления);
	КонецЕсли;

КонецФункции

Функция ЗначениеИзСтрокиДляСоставногоТипа(ОписаниеТипов, Стр)
	
	// Для составного типа: ссылка по УИД, число, булево, дата, иначе строка.

	Если ЭтоУникальныйИдентификатор(Стр) Тогда
		Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
			Менеджер = МенеджерСсылочногоТипа(ТипЗначения);
			Если Менеджер <> Неопределено Тогда
				Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ОписаниеТипов.СодержитТип(Тип("Число")) И ЭтоЧисло(Стр) Тогда
		Возврат ЧислоИзСтроки(Стр);
	КонецЕсли;

	ЗначениеБулево = БулевоИзСтроки(Стр);
	Если ОписаниеТипов.СодержитТип(Тип("Булево")) И ЗначениеБулево <> Неопределено Тогда
		Возврат ЗначениеБулево;
	КонецЕсли;

	Если ОписаниеТипов.СодержитТип(Тип("Дата")) И ЗначениеЗаполнено(ДатаИзСтроки(Стр)) Тогда
		Возврат ДатаИзСтроки(Стр);
	КонецЕсли;

	Возврат Стр;

КонецФункции

Функция ЧислоИзСтроки(Знач Стр)

	// Формат проверяется заранее, поэтому Число() не вызывает исключение; иначе - 0.
	Стр = СтрЗаменить(СтрЗаменить(СокрЛП(Стр), " ", ""), Символы.НПП, "");
	Стр = СтрЗаменить(Стр, ",", ".");
	Если Не ЭтоЧисло(Стр) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Стр);

КонецФункции

Функция ЭтоЧисло(Знач Стр)

	Стр = СтрЗаменить(СокрЛП(Стр), ",", ".");
	Если СтрНачинаетсяС(Стр, "-") Тогда
		Стр = Сред(Стр, 2);
	КонецЕсли;
	Если СтрЧислоВхождений(Стр, ".") > 1 Или СтрНачинаетсяС(Стр, ".") Или СтрЗаканчиваетсяНа(Стр, ".") Тогда
		Возврат Ложь;
	КонецЕсли;
	Стр = СтрЗаменить(Стр, ".", "");

	Возврат ЗначениеЗаполнено(Стр) И СтрокаСостоитИзСимволов(Стр, "0123456789");

КонецФункции

Функция БулевоИзСтроки(Знач Стр)
	
	// Истина, Ложь или Неопределено, если строка не похожа на булево значение.

	Значение = "|" + ВРег(СокрЛП(Стр)) + "|";
	Если СтрНайти("|ИСТИНА|TRUE|ДА|1|", Значение) > 0 Тогда
		Возврат Истина;
	ИначеЕсли СтрНайти("|ЛОЖЬ|FALSE|НЕТ|0|", Значение) > 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ДатаИзСтроки(Знач Стр)
	
	// Дата в формате XML ("2024-01-31T10:00:00" или "2024-01-31"); пустая дата, если строку не разобрать.

	Стр = СокрЛП(Стр);
	Если СтрДлина(Стр) = СтрДлина("ГГГГ-ММ-ДД") Тогда
		Стр = Стр + "T00:00:00";
	КонецЕсли;

	Попытка
		Результат = XMLЗначение(Тип("Дата"), Стр);
	Исключение
		Результат = Дата(1, 1, 1);
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция УникальныйИдентификаторИзСтроки(Знач Стр)

	Если ЭтоУникальныйИдентификатор(Стр) Тогда
		Возврат Новый УникальныйИдентификатор(СокрЛП(Стр));
	КонецЕсли;

	Возврат Новый УникальныйИдентификатор(ПустойУникальныйИдентификатор());

КонецФункции

Функция ЭтоУникальныйИдентификатор(Знач Стр)

	Стр = НРег(СокрЛП(Стр));
	Шаблон = ПустойУникальныйИдентификатор();
	Если СтрДлина(Стр) <> СтрДлина(Шаблон) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Шаблон) Цикл
		Символ = Сред(Стр, Позиция, 1);
		ОжидаетсяДефис = Сред(Шаблон, Позиция, 1) = "-";
		Если ОжидаетсяДефис <> (Символ = "-") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не ОжидаетсяДефис И СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоИдентификатор(Знач Стр)

	// Буквы, цифры и подчеркивание; первый символ - буква или подчеркивание.
	Если Не ЗначениеЗаполнено(Стр) Или СтрНайти("0123456789", Лев(Стр, 1)) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Стр) Цикл
		Символ = Сред(Стр, Позиция, 1);
		ЭтоБуква = ВРег(Символ) <> НРег(Символ);
		Если Не ЭтоБуква И Символ <> "_" И СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоЗарезервированноеСлово(Знач Стр)

	// Слова встроенного языка, которые нельзя использовать как ключ структуры.
	Слова = "|ЕСЛИ|ТОГДА|ИНАЧЕЕСЛИ|ИНАЧЕ|КОНЕЦЕСЛИ|ДЛЯ|КАЖДОГО|ИЗ|ПО|ПОКА|ЦИКЛ|КОНЕЦЦИКЛА|ПРОЦЕДУРА|ФУНКЦИЯ"
		+ "|КОНЕЦПРОЦЕДУРЫ|КОНЕЦФУНКЦИИ|ПЕРЕМ|ПЕРЕЙТИ|ВОЗВРАТ|ПРОДОЛЖИТЬ|ПРЕРВАТЬ|И|ИЛИ|НЕ|ПОПЫТКА|ИСКЛЮЧЕНИЕ"
		+ "|ВЫЗВАТЬИСКЛЮЧЕНИЕ|КОНЕЦПОПЫТКИ|НОВЫЙ|ВЫПОЛНИТЬ|ЭКСПОРТ|ЗНАЧ|ИСТИНА|ЛОЖЬ|НЕОПРЕДЕЛЕНО|NULL"
		+ "|ДОБАВИТЬОБРАБОТЧИК|УДАЛИТЬОБРАБОТЧИК|АСИНХ|ЖДАТЬ"
		+ "|IF|THEN|ELSIF|ELSE|ENDIF|FOR|EACH|IN|TO|WHILE|DO|ENDDO|PROCEDURE|FUNCTION|ENDPROCEDURE|ENDFUNCTION"
		+ "|VAR|GOTO|RETURN|CONTINUE|BREAK|AND|OR|NOT|TRY|EXCEPT|RAISE|ENDTRY|NEW|EXECUTE|EXPORT|VAL"
		+ "|TRUE|FALSE|UNDEFINED|ADDHANDLER|REMOVEHANDLER|ASYNC|AWAIT|";
	Возврат СтрНайти(Слова, "|" + ВРег(СокрЛП(Стр)) + "|") > 0;

КонецФункции

Функция ПустойУникальныйИдентификатор()

	Возврат "00000000-0000-0000-0000-000000000000";

КонецФункции

Функция СтрокаСостоитИзСимволов(Стр, ДопустимыеСимволы)

	Для Позиция = 1 По СтрДлина(Стр) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Стр, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ПоискСсылок

Функция СсылкаИзСтроки(ТипЗначения, Стр, СпособСопоставления)
	
	// Ссылка или значение перечисления по строке. Пустая строка - пустая ссылка;
	// значение, которое не удалось найти, - Неопределено (отбор по нему не вернет строк).

	ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМД = Неопределено Тогда
		Возврат Стр;
	КонецЕсли;

	Если Метаданные.Перечисления.Содержит(ОбъектМД) Тогда
		Возврат ЗначениеПеречисленияИзСтроки(ОбъектМД, Стр);
	КонецЕсли;

	Менеджер = МенеджерСсылочногоТипа(ТипЗначения);
	Если Менеджер = Неопределено Тогда
		Возврат Стр;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Стр) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;

	Способы = Перечисления.МС_СпособСопоставленияПараметраОтбора;
	Способ = ?(ЗначениеЗаполнено(СпособСопоставления), СпособСопоставления, Способы.Авто);

	Ссылка = Неопределено;
	Если Способ = Способы.Идентификатор Или Способ = Способы.Авто Тогда
		Ссылка = СсылкаПоУникальномуИдентификатору(Менеджер, Стр);
	КонецЕсли;
	Если Ссылка = Неопределено И (Способ = Способы.Код Или Способ = Способы.Авто) Тогда
		Ссылка = СсылкаПоКодуИлиНомеру(ОбъектМД, Менеджер, Стр);
	КонецЕсли;
	Если Ссылка = Неопределено И (Способ = Способы.Наименование Или Способ = Способы.Авто) Тогда
		Ссылка = СсылкаПоНаименованию(ОбъектМД, Менеджер, Стр);
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция ЗначениеПеречисленияИзСтроки(ОбъектМД, Стр)

	Если Не ЗначениеЗаполнено(Стр) Тогда
		Возврат Перечисления[ОбъектМД.Имя].ПустаяСсылка();
	КонецЕсли;

	СтрВРег = ВРег(Стр);
	Для Каждого ЗначениеМД Из ОбъектМД.ЗначенияПеречисления Цикл
		Если ВРег(ЗначениеМД.Имя) = СтрВРег Или ВРег(ЗначениеМД.Представление()) = СтрВРег Тогда
			Возврат Перечисления[ОбъектМД.Имя][ЗначениеМД.Имя];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция МенеджерСсылочногоТипа(ТипЗначения)

	ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.Справочники.Содержит(ОбъектМД) Тогда
		Возврат Справочники[ОбъектМД.Имя];
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМД) Тогда
		Возврат Документы[ОбъектМД.Имя];
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМД) Тогда
		Возврат ПланыВидовХарактеристик[ОбъектМД.Имя];
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМД) Тогда
		Возврат ПланыСчетов[ОбъектМД.Имя];
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМД) Тогда
		Возврат ПланыВидовРасчета[ОбъектМД.Имя];
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМД) Тогда
		Возврат БизнесПроцессы[ОбъектМД.Имя];
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМД) Тогда
		Возврат Задачи[ОбъектМД.Имя];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция СсылкаПоУникальномуИдентификатору(Менеджер, Стр)

	Если ЭтоУникальныйИдентификатор(Стр) Тогда
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Стр)));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СсылкаПоКодуИлиНомеру(ОбъектМД, Менеджер, Стр)
	
	// Поиск по коду (справочники, планы) или по номеру (документы, бизнес-процессы, задачи).

	Если ЭтоОбъектСНомером(ОбъектМД) Тогда
		Если ОбъектМД.ДлинаНомера = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Номер = ?(ОбъектМД.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Число, ЧислоИзСтроки(Стр), Стр);
		Ссылка = Менеджер.НайтиПоНомеру(Номер);
	Иначе
		Если ОбъектМД.ДлинаКода = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Код = ?(ЭтоЧисловойКодСправочника(ОбъектМД), ЧислоИзСтроки(Стр), Стр);
		Ссылка = Менеджер.НайтиПоКоду(Код);
	КонецЕсли;

	Возврат ?(Ссылка.Пустая(), Неопределено, Ссылка);

КонецФункции

Функция СсылкаПоНаименованию(ОбъектМД, Менеджер, Стр)

	Если ЭтоОбъектСНомером(ОбъектМД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ОбъектМД.ДлинаНаименования = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = Менеджер.НайтиПоНаименованию(Стр, Истина);
	Возврат ?(Ссылка.Пустая(), Неопределено, Ссылка);

КонецФункции

Функция ЭтоОбъектСНомером(ОбъектМД)

	// Документы, бизнес-процессы и задачи идентифицируются номером, а не кодом и наименованием.
	Возврат Метаданные.Документы.Содержит(ОбъектМД)
		Или Метаданные.БизнесПроцессы.Содержит(ОбъектМД)
		Или Метаданные.Задачи.Содержит(ОбъектМД);

КонецФункции

Функция ЭтоЧисловойКодСправочника(ОбъектМД)

	Возврат Метаданные.Справочники.Содержит(ОбъектМД)
		И ОбъектМД.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Число;

КонецФункции

