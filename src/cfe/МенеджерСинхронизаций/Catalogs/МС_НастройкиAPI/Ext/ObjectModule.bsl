#Если Сервер Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(HTTPМетод) Тогда
		HTTPМетод = Перечисления.МС_HTTPМетодAPI.GET;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ФорматОтвета) Тогда
		ФорматОтвета = Перечисления.МС_ФорматОтветаAPI.JSON;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СпособПолученияДанных) Тогда
		СпособПолученияДанных = Перечисления.МС_СпособПолученияДанныхAPI.ТекстЗапроса;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КонструкторТипИсточника) Тогда
		КонструкторТипИсточника = Перечисления.МС_ТипИсточникаКонструктораAPI.Справочник;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если СпособПолученияДанных = Перечисления.МС_СпособПолученияДанныхAPI.ТекстЗапроса Тогда
		ПроверяемыеРеквизиты.Добавить("ТекстЗапроса");
	КонецЕсли;
	Если СпособПолученияДанных = Перечисления.МС_СпособПолученияДанныхAPI.ПрограммныйМодуль Тогда
		ПроверяемыеРеквизиты.Добавить("ИмяМетодаОбработчика");
	КонецЕсли;
	Если СпособПолученияДанных = Перечисления.МС_СпособПолученияДанныхAPI.Конструктор Тогда
		ПроверяемыеРеквизиты.Добавить("КонструкторИмяОбъекта");
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ВерсияAPI = СокрЛП(ВерсияAPI);
	ПараметрURL = СокрЛП(ПараметрURL);

	ПроверитьСегментURL(ВерсияAPI, "ВерсияAPI", "Версия API", Отказ);
	ПроверитьСегментURL(ПараметрURL, "ПараметрURL", "Параметр URL", Отказ);
	ПроверитьУникальностьАдреса(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСегментURL(Значение, ИмяРеквизита, Представление, Отказ)
	
	// Значение - сегмент адреса API, поэтому разделители адреса и пробелы в нем недопустимы.

	НедопустимыеСимволы = "/\?#&%= ";
	Для Индекс = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		Если СтрНайти(Значение, Сред(НедопустимыеСимволы, Индекс, 1)) > 0 Тогда
			ТекстСообщения = СтрШаблон(
				"Поле ""%1"" не должно содержать символы / \ ? # & %% = и пробелы: значение является частью адреса API.",
				Представление);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, ИмяРеквизита, "Объект", Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУникальностьАдреса(Отказ)
	
	// Сравнение без учета регистра - так же, как настройка ищется при обработке HTTP-запроса.

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МС_НастройкиAPI КАК Спр
	|ГДЕ
	|	ВРЕГ(Спр.ВерсияAPI) = &ВерсияAPI
	|	И ВРЕГ(Спр.ПараметрURL) = &ПараметрURL
	|	И Спр.HTTPМетод = &HTTPМетод
	|	И Спр.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("ВерсияAPI", ВРег(ВерсияAPI));
	Запрос.УстановитьПараметр("ПараметрURL", ВРег(ПараметрURL));
	Запрос.УстановитьПараметр("HTTPМетод", HTTPМетод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"Настройка с такой комбинацией версии API, имени шаблона URL и HTTP-метода уже существует.",
			ЭтотОбъект, "ПараметрURL", "Объект", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
