КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеФормы

&НаСервере
Процедура ЗаполнитьФормуПоОбъекту()

	Если Не ЗначениеЗаполнено(БазовыйАдресAPI) Тогда
		ЗаполнитьБазовыйАдресAPI();
	КонецЕсли;

	МС_HTTPAPIКонструкторСервер.ЗагрузитьКонструкторВТаблицыФормы(Объект, ПоляКонструктора, ОтборыКонструктора);
	ОбновитьСпискиВыбораКонструктора();
	ПредпросмотрИмениТаблицы = МС_HTTPAPIКонструкторСервер.ИмяТаблицыНастройки(Объект);
	ЗаполнитьПараметрыAPIИзОтборовКонструктора();
	МС_HTTPAPIСервер.СинхронизироватьТестовыеЗначенияСПараметрамиЗапроса(Объект);
	ЗагрузитьПараметрыЗаписиJSONВФорму();
	ОбновитьИтоговыйАдресAPI(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБазовыйАдресAPI()

	БазовыйАдрес = МС_HTTPAPIСервер.БазовыйАдресHTTPAPI();
	БазовыйАдресAPI = БазовыйАдрес.Адрес;
	Если Не БазовыйАдрес.АдресПубликацииЗадан Тогда
		Элементы.ИтоговыйАдресAPI.Подсказка =
			"Адрес публикации информационной базы не задан. Укажите его в настройках администрирования
			|(Адрес публикации в локальной сети / в Интернете), тогда здесь отобразится полный адрес API.";
		Элементы.ИтоговыйАдресAPI.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;

КонецПроцедуры

// После смены источника: списки выбора, имя таблицы, параметры API из отборов и видимость полей мастера.
&НаСервере
Процедура ОбновитьМастерКонструктора()

	ОбновитьСпискиВыбораКонструктора();
	ПредпросмотрИмениТаблицы = МС_HTTPAPIКонструкторСервер.ИмяТаблицыНастройки(Объект);
	ЗаполнитьПараметрыAPIИзОтборовКонструктора();
	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиВыбораКонструктора()

	ЗаполнитьСписокВыбора(Элементы.КонструкторИмяОбъекта.СписокВыбора,
		МС_HTTPAPIКонструкторСервер.СписокОбъектовПоТипу(Объект.КонструкторТипИсточника));
	ЗаполнитьСписокВыбора(Элементы.КонструкторИмяТабличнойЧасти.СписокВыбора,
		МС_HTTPAPIКонструкторСервер.СписокТабличныхЧастей(Объект.КонструкторТипИсточника, Объект.КонструкторИмяОбъекта));

	ИмяТаблицы = МС_HTTPAPIКонструкторСервер.ИмяТаблицыНастройки(Объект);

	// Срезы есть только у периодических регистров сведений; для других таблиц поле скрыто и очищено.
	ВариантыВиртуальнойТаблицы = МС_HTTPAPIКонструкторСервер.ВариантыВиртуальнойТаблицы(ИмяТаблицы);
	СписокВиртуальныхТаблиц = Элементы.КонструкторВиртуальнаяТаблица.СписокВыбора;
	СписокВиртуальныхТаблиц.Очистить();
	Для Каждого Вариант Из ВариантыВиртуальнойТаблицы Цикл
		СписокВиртуальныхТаблиц.Добавить(Вариант.Значение, Вариант.Представление);
	КонецЦикла;
	Объект.КонструкторВиртуальнаяТаблица = МС_HTTPAPIКонструкторСервер.ВиртуальнаяТаблицаНастройки(Объект, ИмяТаблицы);
	Элементы.КонструкторВиртуальнаяТаблица.Видимость = ВариантыВиртуальнойТаблицы.Количество() > 1;

	ИменаПолейОтборов = Новый Массив;
	Для Каждого СтрокаОтбора Из ОтборыКонструктора Цикл
		ИменаПолейОтборов.Добавить(СтрокаОтбора.Поле);
	КонецЦикла;
	МС_HTTPAPIКонструкторСервер.ЗаполнитьСписокВыбораПолейОтбора(ИмяТаблицы,
		Элементы.ОтборыКонструктораПоле.СписокВыбора, ИменаПолейОтборов);

	ИменаПолейОтвета = Новый Массив;
	Для Каждого СтрокаПоля Из ПоляКонструктора Цикл
		ИменаПолейОтвета.Добавить(СтрокаПоля.ИмяПоля);
	КонецЦикла;
	МС_HTTPAPIКонструкторСервер.ЗаполнитьСписокВыбораПолейОтбора(ИмяТаблицы,
		Элементы.ПоляКонструктораИмяПоля.СписокВыбора, ИменаПолейОтвета);

КонецПроцедуры

