#Область ОбработчикиСобытийЭлементовТаблицыФормыПоляКонструктора

&НаКлиенте
Процедура ПоляКонструктораПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.Включить = Истина;
		Элемент.ТекущиеДанные.Формат = "Представление";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоляКонструктораРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ПоляКонструктора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = РеквизитыДляФорматаПоля(ПредпросмотрИмениТаблицы, ТекущиеДанные.ИмяПоля);
	Если Реквизиты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Поле не является ссылкой на справочник, документ или план видов характеристик: "
			+ "реквизиты для него не выбираются.");
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	Оповещение = Новый ОписаниеОповещения("ПоляКонструктораРеквизитПослеВыбора", ЭтотОбъект, ДополнительныеПараметры);
	НачальноеЗначение = Реквизиты.НайтиПоЗначению(ТекущиеДанные.Реквизит);
	ПоказатьВыборИзСписка(Оповещение, Реквизиты, Элемент, НачальноеЗначение);

КонецПроцедуры

&НаКлиенте
Процедура ПоляКонструктораРеквизитПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаПоля = ПоляКонструктора.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаПоля.Реквизит = ВыбранныйЭлемент.Значение;
	СтрокаПоля.Формат = "Реквизит";
	Модифицированность = Истина;

КонецПроцедуры

