
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокВыбораСравненияОтбора();
	ЗаполнитьСписокВыбораФорматаПоля();
	ЗаполнитьСпискиВыбораПараметровЗаписиJSON();

	// Существующий элемент заполняется в ПриЧтенииНаСервере, который вызывается раньше.
	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьФормуПоОбъекту();
	КонецЕсли;

	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// Вызывается при открытии существующего элемента и при повторном чтении после записи.
	ЗаполнитьФормуПоОбъекту();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.ФорматОтвета = Перечисления.МС_ФорматОтветаAPI.JSON Тогда
		НастройкиЗаписиJSON = НастройкиЗаписиJSONФормы();
		ТекущийОбъект.JSONПараметрыЗаписи = МС_HTTPAPIСервер.СтрокаНастроекЗаписиJSONИзСтруктурыФормы(НастройкиЗаписиJSON);
	КонецЕсли;

	Способ = ТекущийОбъект.СпособПолученияДанных;
	Если Способ = Перечисления.МС_СпособПолученияДанныхAPI.Конструктор Тогда
		ТекстОшибки = МС_HTTPAPIКонструкторСервер.ОшибкаПолейКонструктора(ПоляКонструктора);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "ПоляКонструктора", , Отказ);
			Возврат;
		КонецЕсли;
		ТекстОшибки = МС_HTTPAPIКонструкторСервер.ОшибкаВиртуальнойТаблицы(ТекущийОбъект);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Объект.КонструкторПараметрПериода", , Отказ);
			Возврат;
		КонецЕсли;
		МС_HTTPAPIКонструкторСервер.ПрименитьМастерКонструкторуКОбъекту(ТекущийОбъект, ПоляКонструктора, ОтборыКонструктора);
		МС_HTTPAPIСервер.ЗаполнитьПараметрыЗапросаИзОтборовКонструктораПоJSON(ТекущийОбъект);
	КонецЕсли;

	Если Способ = Перечисления.МС_СпособПолученияДанныхAPI.ТекстЗапроса Тогда
		ТекстОшибки = МС_HTTPAPIСервер.ОшибкаСоответствияПараметровИТекстаЗапроса(
			ТекущийОбъект.ТекстЗапроса, ТекущийОбъект.ПараметрыЗапроса);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Объект.ПараметрыЗапроса", , Отказ);
		КонецЕсли;
	КонецЕсли;

	МС_HTTPAPIСервер.СинхронизироватьТестовыеЗначенияСПараметрамиЗапроса(ТекущийОбъект);

КонецПроцедуры

#КонецОбласти

