&НаСервере
Функция ЗаполнитьПараметрыИзОтборовКонструктораНаСервере()

	Если Объект.СпособПолученияДанных <> Перечисления.МС_СпособПолученияДанныхAPI.Конструктор Тогда
		Возврат "";
	КонецЕсли;

	ЗаполнитьПараметрыAPIИзОтборовКонструктора();
	Если Объект.ПараметрыЗапроса.Количество() = 0 Тогда
		Возврат "В отборах нет строк с заполненным ""Параметр запроса"". "
			+ "Такие строки нужны, чтобы передать значение отбора из вызова API (query или тело). "
			+ "Значение в колонке ""Фиксированное значение"" задает постоянный отбор без параметра - "
			+ "оно не попадает в список ""Параметры запроса"".";
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ДанныеВводаЗначенияОтбора(Знач ИмяТаблицы, Знач Поле, Знач ЗначениеВнутр, Знач ЗначениеКонстанты)

	ОписаниеТипов = МС_HTTPAPIКонструкторСервер.ПолучитьОписаниеТипаПоляТаблицы(ИмяТаблицы, Поле);
	Если ОписаниеТипов.Типы().Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗначениеСтрокой = СокрЛП(ЗначениеКонстанты);
	Отбор = Новый Структура("Поле, ЗначениеВнутр, Значение", Поле, ЗначениеВнутр,
		?(ЗначениеЗаполнено(ЗначениеСтрокой), ЗначениеСтрокой, Неопределено));
	НачальноеЗначение = Неопределено;
	Если МС_HTTPAPIКонструкторСервер.ЕстьФиксированноеЗначениеОтбора(Отбор) Тогда
		НачальноеЗначение = МС_HTTPAPIКонструкторСервер.ЗначениеФиксированногоОтбора(Отбор, ИмяТаблицы);
	КонецЕсли;

	Возврат Новый Структура("ОписаниеТипов, НачальноеЗначение", ОписаниеТипов, НачальноеЗначение);

