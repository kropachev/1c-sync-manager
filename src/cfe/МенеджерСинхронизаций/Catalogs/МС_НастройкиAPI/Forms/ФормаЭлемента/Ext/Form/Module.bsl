&НаКлиенте
Процедура ОтборыКонструктораПолеПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОтборыКонструктора.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЗначениеКонстанты = "";
		ТекущиеДанные.ЗначениеВнутр = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборыКонструктораЗначениеКонстантыПриИзменении(Элемент)

	// Значение введено вручную - при записи оно будет приведено к типу поля.
	// Фиксированное значение важнее параметра, поэтому параметр строки очищается.
	ТекущиеДанные = Элементы.ОтборыКонструктора.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЗначениеВнутр = "";
		Если ЗначениеЗаполнено(ТекущиеДанные.ЗначениеКонстанты) Тогда
			ТекущиеДанные.ИмяПараметра = "";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборыКонструктораЗначениеКонстантыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОтборыКонструктора.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Поле) Тогда
		ПоказатьПредупреждение(, "Сначала выберите поле отбора.");
		Возврат;
	КонецЕсли;

	// Один серверный вызов: тип поля определяется только по метаданным.
	ДанныеВвода = ДанныеВводаЗначенияОтбора(ПредпросмотрИмениТаблицы,
		ТекущиеДанные.Поле, ТекущиеДанные.ЗначениеВнутр, ТекущиеДанные.ЗначениеКонстанты);
	Если ДанныеВвода = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось определить тип поля по метаданным. Введите значение вручную в ячейке.");
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	Оповещение = Новый ОписаниеОповещения("ОтборыКонструктораЗначениеКонстантыПослеВвода", ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВводЗначения(Оповещение, ДанныеВвода.НачальноеЗначение, "Значение отбора (фикс.)", ДанныеВвода.ОписаниеТипов);

КонецПроцедуры

&НаКлиенте
Процедура ОтборыКонструктораЗначениеКонстантыПослеВвода(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаОтбора = ОтборыКонструктора.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
	Если СтрокаОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеЗначения = ДанныеФиксированногоЗначенияОтбора(Результат);
	СтрокаОтбора.ЗначениеКонстанты = ДанныеЗначения.Представление;
	СтрокаОтбора.ЗначениеВнутр = ДанныеЗначения.ЗначениеВнутр;
	// Фиксированное значение важнее параметра: параметр строки очищается и уходит из "Параметров запроса".
	СтрокаОтбора.ИмяПараметра = "";
	Модифицированность = Истина;
	ОтборыКонструктораПриИзмененииНаСервере();

КонецПроцедуры

