// Видимость элементов по способу получения данных, источнику конструктора и формату ответа.
// Элементы способа лежат на страницах без отображения: показывается страница "Группа" + имя способа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента настройки API.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	Способ = Объект.СпособПолученияДанных;
	ЭтоТекстЗапроса = (Способ = ПредопределенноеЗначение("Перечисление.МС_СпособПолученияДанныхAPI.ТекстЗапроса"));
	ЭтоПрограммный = (Способ = ПредопределенноеЗначение("Перечисление.МС_СпособПолученияДанныхAPI.ПрограммныйМодуль"));
	ЭтоКонструктор = Не ЭтоТекстЗапроса И Не ЭтоПрограммный;

	Если ЭтоТекстЗапроса Тогда
		Элементы.ГруппаСпособыПолученияДанных.ТекущаяСтраница = Элементы.ГруппаТекстЗапроса;
	ИначеЕсли ЭтоПрограммный Тогда
		Элементы.ГруппаСпособыПолученияДанных.ТекущаяСтраница = Элементы.ГруппаПрограммныйМодуль;
	Иначе
		Элементы.ГруппаСпособыПолученияДанных.ТекущаяСтраница = Элементы.ГруппаКонструктор;
	КонецЕсли;

	// Элементы способа вне страниц: команды и колонки параметров API, лимит строк.
	Элементы.ПараметрыЗапросаЗаполнитьИзТекста.Видимость = ЭтоТекстЗапроса;
	Элементы.ПараметрыЗапросаЗаполнитьИзОтборов.Видимость = ЭтоКонструктор;
	Элементы.ПараметрыЗапросаИсточник.Видимость = ЭтоПрограммный;
	Элементы.ЛимитСтрок.Видимость = Не ЭтоПрограммный;
	// В конструкторе параметры API формируются из отборов.
	Элементы.ПараметрыЗапросаИмяПараметра.ТолькоПросмотр = ЭтоКонструктор;
	Элементы.ПараметрыЗапросаТипПараметра.ТолькоПросмотр = ЭтоКонструктор;

	ТипИсточника = Объект.КонструкторТипИсточника;
	Элементы.КонструкторИмяТабличнойЧасти.Видимость =
		ТипИсточника = ПредопределенноеЗначение("Перечисление.МС_ТипИсточникаКонструктораAPI.Справочник")
		Или ТипИсточника = ПредопределенноеЗначение("Перечисление.МС_ТипИсточникаКонструктораAPI.Документ");
	Элементы.КонструкторПараметрПериода.Видимость = ЗначениеЗаполнено(Объект.КонструкторВиртуальнаяТаблица);

	Элементы.ГруппаПараметрыЗаписиJSON.Видимость =
		(Объект.ФорматОтвета = ПредопределенноеЗначение("Перечисление.МС_ФорматОтветаAPI.JSON"));

КонецПроцедуры

// Адрес вызова: базовый адрес сервиса + /{Версия}/{ПараметрURL}.
// Для методов без тела (GET, HEAD, DELETE, OPTIONS) параметры запроса добавляются в строку запроса
// со значениями из "Тестовые значения параметров"; для POST, PUT, PATCH параметры передаются в теле.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента настройки API.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоговыйАдресAPI(Форма)

	Адрес = Форма.БазовыйАдресAPI
		+ "/" + ?(ЗначениеЗаполнено(Форма.Объект.ВерсияAPI), СокрЛП(Форма.Объект.ВерсияAPI), "<версия>")
		+ "/" + ?(ЗначениеЗаполнено(Форма.Объект.ПараметрURL), СокрЛП(Форма.Объект.ПараметрURL), "<параметр URL>");

	ПараметрыВТеле = Форма.Объект.HTTPМетод = ПредопределенноеЗначение("Перечисление.МС_HTTPМетодAPI.POST")
		Или Форма.Объект.HTTPМетод = ПредопределенноеЗначение("Перечисление.МС_HTTPМетодAPI.PUT")
		Или Форма.Объект.HTTPМетод = ПредопределенноеЗначение("Перечисление.МС_HTTPМетодAPI.PATCH");

	Если Не ПараметрыВТеле Тогда
		ЧастиЗапроса = Новый Массив;
		Для Каждого СтрокаПараметра Из Форма.Объект.ПараметрыЗапроса Цикл
			Имя = СокрЛП(СтрокаПараметра.ИмяПараметра);
			Если Не ЗначениеЗаполнено(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Значение = "";
			Отбор = Новый Структура("ИмяПараметра", Имя);
			Для Каждого СтрокаТеста Из Форма.Объект.ТестовыеЗначенияПараметров.НайтиСтроки(Отбор) Цикл
				Значение = СтрокаТеста.Значение;
			КонецЦикла;
			ЧастьЗапроса = КодироватьКомпонентURL(Имя) + "=" + КодироватьКомпонентURL(Значение);
			ЧастиЗапроса.Добавить(ЧастьЗапроса);
		КонецЦикла;
		Если ЧастиЗапроса.Количество() > 0 Тогда
			Адрес = Адрес + "?" + СтрСоединить(ЧастиЗапроса, "&");
		КонецЕсли;
	КонецЕсли;

	Форма.ИтоговыйАдресAPI = Адрес;

КонецПроцедуры

// Кодирует служебные символы адреса. КодироватьСтроку на клиенте недоступна;
// кириллицу и прочие символы браузер и HTTP-клиенты кодируют сами.
//
// Параметры:
//  Значение - Строка - имя или значение параметра запроса.
//
// Возвращаемое значение:
//  Строка - значение для строки запроса.
//
&НаКлиентеНаСервереБезКонтекста
Функция КодироватьКомпонентURL(Знач Значение)

	Результат = СтрЗаменить(Значение, "%", "%25");
	Замены = Новый Соответствие;
	Замены.Вставить(" ", "%20");
	Замены.Вставить("&", "%26");
	Замены.Вставить("=", "%3D");
	Замены.Вставить("#", "%23");
	Замены.Вставить("+", "%2B");
	Замены.Вставить("?", "%3F");
	Для Каждого Замена Из Замены Цикл
		Результат = СтрЗаменить(Результат, Замена.Ключ, Замена.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
