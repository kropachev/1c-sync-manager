// Данные сообщения текущей записи журнала показываются в поле справа от списка. Журнал хранит данные
// в том виде, в котором они получены или отправлены. Переключатель над полем (запоминается в настройках
// формы): "Исходный текст" (по умолчанию) - данные как хранятся, "Форматированный" - JSON с переносами
// строк и отступами.

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимДанныхСообщенияПриИзменении(Элемент)

	ПоказатьДанныеСообщения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьДанныеСообщения", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьДанныеСообщения()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ДанныеСообщенияПросмотр = "";
		Возврат;
	КонецЕсли;
	// РежимДанныхСообщения: 0 - исходный текст, 1 - форматированный JSON.
	Если РежимДанныхСообщения = 1 Тогда
		ДанныеСообщенияПросмотр = ФорматированныйJSON(ТекущиеДанные.ДанныеСообщения);
	Иначе
		ДанныеСообщенияПросмотр = ТекущиеДанные.ДанныеСообщения;
	КонецЕсли;

КонецПроцедуры

// JSON с переносами строк и отступами. Текст переписывается по элементам (ЧтениеJSON -> ЗаписьJSON):
// порядок свойств, числа и строки сохраняются как есть.
//
// Параметры:
//   Текст - Строка - данные сообщения.
//
// Возвращаемое значение:
//   Строка - форматированный JSON; исходный текст, если это не JSON или его не удалось прочитать.
//
&НаКлиенте
Функция ФорматированныйJSON(Текст)

	НачалоТекста = Лев(СокрЛ(Текст), 1);
	Если НачалоТекста <> "{" И НачалоТекста <> "[" Тогда
		Возврат Текст;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Запись = Новый ЗаписьJSON;
	Попытка
		Чтение.УстановитьСтроку(Текст);
		Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
		Пока Чтение.Прочитать() Цикл
			ПереписатьЭлементJSON(Чтение, Запись);
		КонецЦикла;
		Чтение.Закрыть();
		Возврат Запись.Закрыть();
	Исключение
		// Не JSON или JSON с ошибкой: показывается исходный текст.
		Возврат Текст;
	КонецПопытки;

КонецФункции

// Переносит текущий элемент чтения JSON в запись.
//
// Параметры:
//   Чтение - ЧтениеJSON - чтение, установленное на элемент.
//   Запись - ЗаписьJSON - запись.
//
&НаКлиенте
Процедура ПереписатьЭлементJSON(Чтение, Запись)

	ТипЭлемента = Чтение.ТипТекущегоЗначения;
	Если ТипЭлемента = ТипЗначенияJSON.НачалоОбъекта Тогда
		Запись.ЗаписатьНачалоОбъекта();
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.КонецОбъекта Тогда
		Запись.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.НачалоМассива Тогда
		Запись.ЗаписатьНачалоМассива();
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.КонецМассива Тогда
		Запись.ЗаписатьКонецМассива();
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.ИмяСвойства Тогда
		Запись.ЗаписатьИмяСвойства(Чтение.ТекущееЗначение);
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.Null Тогда
		Запись.ЗаписатьЗначение(Неопределено);
	ИначеЕсли ТипЭлемента = ТипЗначенияJSON.Комментарий Тогда
		Возврат;
	Иначе
		Запись.ЗаписатьЗначение(Чтение.ТекущееЗначение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
